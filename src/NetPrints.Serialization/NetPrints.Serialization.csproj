<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NetPrintsTrackPublicApi>true</NetPrintsTrackPublicApi>
    <AssemblyName>NetPrints.Serialization</AssemblyName>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>Graph documents, formats and the project store for NetPrints. NetPrints continues the original NetPrints by Robin Kahlow (https://github.com/RobinKa/netprints).</Description>
    <!-- Ahead of using it (T022+): keep the logging-usage rules an error once logging is added here. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1848;CA2254</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- FileSystemDocumentStore.Changes: per-id debounce/throttle and the IObservable<DocumentChange> it exposes. -->
    <PackageReference Include="System.Reactive" />
  </ItemGroup>
  <ItemGroup>
    <NetPrintsExperimentalOptIn Include="NPXE0013" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetPrints.Editor" />
    <InternalsVisibleTo Include="NetPrints.Editor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetPrints.Core\NetPrints.Core.csproj" />
  </ItemGroup>
</Project>
