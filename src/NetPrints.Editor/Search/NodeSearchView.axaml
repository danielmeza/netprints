<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:edsearch="clr-namespace:NetPrints.Editor.Search"
             x:Class="NetPrints.Editor.Search.NodeSearchView"
             x:DataType="edsearch:SuggestionListVM"
             Width="700" Height="300" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.NodeSearch}">
  <!-- Node search popup (PAR-52): search box, virtualized grouped list with 16-px icons. -->
  <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="1">
    <Grid RowDefinitions="Auto,*">
      <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SearchBox}" Text="{Binding SearchText}" PlaceholderText="Search" Margin="4">
        <Interaction.Behaviors>
          <!-- Enter picks and opens the first non-header result; fits ExecuteCommandOnKeyDownBehavior
               plus a VM SelectFirstCommand (batch X2b). -->
          <ExecuteCommandOnKeyDownBehavior Key="Enter" Command="{Binding SelectFirstCommand}" />
          <!-- Down highlights the first result (VM decision) and hands focus to the list (view
               mechanics); no single prebuilt behavior does both, so this pairs InvokeCommandAction
               with FocusControlAction under one KeyTrigger. -->
          <KeyTrigger Key="Down">
            <InvokeCommandAction Command="{Binding HighlightFirstCommand}" />
            <FocusControlAction TargetControl="ResultList" />
          </KeyTrigger>
        </Interaction.Behaviors>
      </TextBox>
      <TextBlock Grid.Row="1" Text="Loading..." IsVisible="{Binding IsLoading}" Margin="8" />
      <!-- IsEnabled="{Binding !IsFiltering}" (FLAKE-01): disabled while the debounced filter is
           still in flight, so a row that only matches the previous, unfiltered view cannot be
           clicked and then replaced out from under the pointer once the filter lands. -->
      <ListBox x:Name="ResultList" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SearchResults}" Grid.Row="1" ItemsSource="{Binding Items}" IsVisible="{Binding !IsLoading}"
               IsEnabled="{Binding !IsFiltering}" SelectionMode="Single" SelectedItem="{Binding SelectedItem}">
        <Interaction.Behaviors>
          <!-- Enter selects the highlighted result; fits ExecuteCommandOnKeyDownBehavior (batch X2b). -->
          <ExecuteCommandOnKeyDownBehavior Key="Enter" Command="{Binding SelectCommand}" CommandParameter="{Binding SelectedItem}" />
        </Interaction.Behaviors>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="20" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="edsearch:SuggestionItem">
            <Panel Background="Transparent">
              <!-- Tap selects a result; the VM's own guard skips headers (fits
                   ExecuteCommandOnTappedBehavior plus a VM guard, batch X2b). -->
              <Interaction.Behaviors>
                <ExecuteCommandOnTappedBehavior
                  Command="{Binding $parent[ListBox].((edsearch:SuggestionListVM)DataContext).SelectCommand}"
                  CommandParameter="{Binding}" />
              </Interaction.Behaviors>
              <TextBlock Text="{Binding Category}" IsVisible="{Binding IsHeader}" FontWeight="Bold"
                         Foreground="{DynamicResource SystemAccentColor}" />
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsHeader}" Margin="12,0,0,0">
                <Image Width="16" Height="16" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SearchRowIcon}" AutomationProperties.Name="{Binding Text}" Source="{Binding IconKey, Converter={x:Static edsearch:IconConverter.Instance}}" />
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SearchRowText}" />
              </StackPanel>
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
