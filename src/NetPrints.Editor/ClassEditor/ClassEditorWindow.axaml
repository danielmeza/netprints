<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:ederrorlist="clr-namespace:NetPrints.Editor.ErrorList"
        xmlns:edclasseditor="clr-namespace:NetPrints.Editor.ClassEditor"
        xmlns:edevents="clr-namespace:NetPrints.Editor.Events"
        xmlns:edgraph="clr-namespace:NetPrints.Editor.Graph"
        xmlns:edinspectors="clr-namespace:NetPrints.Editor.Inspectors"
        xmlns:edsearch="clr-namespace:NetPrints.Editor.Search"
        xmlns:edvariables="clr-namespace:NetPrints.Editor.Variables"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="NetPrints.Editor.ClassEditor.ClassEditorWindow"
        x:DataType="edclasseditor:ClassEditorVM"
        Title="{Binding Title}"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        Width="1280" Height="720" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorWindow}" AutomationProperties.Name="{Binding FullName}">
  <!-- Keyboard (PAR-37) -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedNodesCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="100,*">
    <!-- Toolbar (PAR-23) -->
    <StackPanel Orientation="Horizontal">
      <Button x:Name="CompileButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorCompileButton}" Classes="round" Content="Compile" Margin="5"
              IsEnabled="{Binding Project.CanCompile, FallbackValue=False}" Command="{Binding CompileCommand}"
              ToolTip.Tip="Compiles the project and outputs the source code if chosen." />
      <Button x:Name="RunButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorRunButton}" Classes="round" Content="Run" Margin="5"
              IsEnabled="{Binding Project.CanCompileAndRun, FallbackValue=False}" Command="{Binding RunCommand}"
              ToolTip.Tip="Compile and run the project. Only enabled for executable projects that output binaries. Requires a static Main method." />
      <Button x:Name="ClassButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorClassButton}" Classes="round" Content="Class" Margin="5" Command="{Binding ShowClassCommand}"
              ToolTip.Tip="Edit the properties of this class." />
      <Button x:Name="SaveButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorSaveButton}" Classes="round" Content="Save" Margin="5" Command="{Binding SaveCommand}"
              ToolTip.Tip="Saves the project and all its classes." />
    </StackPanel>

    <!-- Resizable columns and rows (PAR-31). The inspector column keeps a sensible minimum
         width so labels, checkboxes and the generated-code preview never clip while dragging
         the splitter (matches the 250-px inspector column of the original WPF layout). -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" MinWidth="150" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="150" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="250" MinWidth="220" />
      </Grid.ColumnDefinitions>
      <Grid RowDefinitions="*,5,*,5,*,5,*" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorLeftColumn}">
        <!-- Methods (PAR-24..26) -->
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Classes="header" Text="Methods" />
          <ListBox x:Name="MethodList" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorMethodList}" Grid.Row="1" ItemsSource="{Binding Methods}"
                   SelectedItem="{Binding SelectedMethod}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="edclasseditor:MethodVM">
                <Grid ColumnDefinitions="Auto,*">
                  <Button Classes="icon" ToolTip.Tip="Remove method"
                          Command="{Binding $parent[Window].((edclasseditor:ClassEditorVM)DataContext).RemoveMethodCommand}"
                          CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Minus" />
                  </Button>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorMethodName}"
                             VerticalAlignment="Center" Background="Transparent"
                             Tapped="OnMethodTapped" PointerPressed="OnMethodPointerPressed" PointerMoved="OnMethodPointerMoved" PointerReleased="OnMethodPointerReleased" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="2" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorCreateMethodButton}" Classes="flat" Content="Create Method" Command="{Binding CreateMethodCommand}" FontSize="16" />
          <ComboBox x:Name="OverrideBox" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorOverrideChooser}" Grid.Row="3" HorizontalAlignment="Stretch" FontSize="16" Margin="4"
                    PlaceholderText="Override a method"
                    ItemsSource="{Binding OverridableMethods}"
                    SelectedItem="{Binding SelectedOverride}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static edsearch:MethodSpecifierConverter.Instance}}" x:CompileBindings="False" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <GridSplitter Grid.Row="1" ResizeDirection="Rows" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorMethodsSplitter}" />

        <!-- Constructors (PAR-27, 28) -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
          <TextBlock Classes="header" Text="Constructors" />
          <ListBox x:Name="ConstructorList" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorConstructorList}" Grid.Row="1" ItemsSource="{Binding Constructors}"
                   SelectedItem="{Binding SelectedMethod}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="edclasseditor:MethodVM">
                <Grid ColumnDefinitions="Auto,*">
                  <Button Classes="icon" ToolTip.Tip="Remove constructor"
                          Command="{Binding $parent[Window].((edclasseditor:ClassEditorVM)DataContext).RemoveMethodCommand}"
                          CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Minus" />
                  </Button>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorMethodName}"
                             VerticalAlignment="Center" Background="Transparent"
                             Tapped="OnMethodTapped" PointerPressed="OnMethodPointerPressed" PointerMoved="OnMethodPointerMoved" PointerReleased="OnMethodPointerReleased" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="2" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorCreateConstructorButton}" Classes="flat" Content="Create Constructor" Command="{Binding CreateConstructorCommand}" FontSize="16" />
        </Grid>

        <GridSplitter Grid.Row="3" ResizeDirection="Rows" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorConstructorsSplitter}" />

        <!-- Variables (PAR-29, 30): two groups, "Class" and "Method: <name>" (FR-030, US5 sub-phase H) -->
        <Grid Grid.Row="4" RowDefinitions="*,*">
          <Grid RowDefinitions="Auto,*,Auto" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariablesClassGroup}">
            <TextBlock Classes="header" Text="Class" />
            <ListBox x:Name="VariableList" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorVariableList}" Grid.Row="1" ItemsSource="{Binding VariablesPanel.ClassVariables}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="edvariables:MemberVariableVM">
                  <edvariables:MemberVariableView />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorCreateVariableButton}" Classes="flat" Content="Create Variable" Command="{Binding CreateVariableCommand}" FontSize="16" />
          </Grid>

          <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" IsVisible="{Binding VariablesPanel.HasMethodGroup}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariablesMethodGroup}">
            <TextBlock Classes="header" Text="{Binding VariablesPanel.MethodGroupHeader}" />
            <ListBox x:Name="LocalVariableList" Grid.Row="1" ItemsSource="{Binding VariablesPanel.MethodVariables}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="edvariables:LocalVariableVM">
                  <edvariables:LocalVariableView />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.CreateLocalVariableButton}" Classes="flat" Content="Create Local Variable" Command="{Binding VariablesPanel.CreateLocalVariableCommand}" FontSize="16" />
          </Grid>
        </Grid>

        <GridSplitter Grid.Row="5" ResizeDirection="Rows" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorEventGraphsSplitter}" />

        <!-- Event graphs (US4) -->
        <Grid Grid.Row="6" RowDefinitions="Auto,*,Auto">
          <TextBlock Classes="header" Text="Event graphs" />
          <ListBox x:Name="EventGraphList" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.EventGraphList}" Grid.Row="1" ItemsSource="{Binding EventGraphs}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="edevents:EventGraphVM">
                <Grid ColumnDefinitions="Auto,*">
                  <Button Classes="icon" ToolTip.Tip="Remove event graph"
                          Command="{Binding $parent[Window].((edclasseditor:ClassEditorVM)DataContext).RemoveEventGraphCommand}"
                          CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Minus" />
                  </Button>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.EventGraphName}"
                             VerticalAlignment="Center" Background="Transparent"
                             DoubleTapped="OnEventGraphDoubleTapped" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="2" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.CreateEventGraphButton}" Classes="flat" Content="Create Event Graph" Command="{Binding CreateEventGraphCommand}" FontSize="16" />
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorLeftSplitter}" />

      <!-- Graph, compile errors, program output and status (PAR-32) -->
      <Grid Grid.Column="2" RowDefinitions="*,5,150,24">
        <edgraph:GraphEditorView x:Name="GraphEditor" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorGraph}" DataContext="{Binding OpenedGraph}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- Busy overlay (PAR-24, batch D1): shown only once an open graph passes ClassEditorVM.BusyIndicatorDelay. -->
        <Border AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorOpeningGraphIndicator}" IsVisible="{Binding IsOpeningGraph}"
                Background="#CC202020" CornerRadius="4" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Foreground="White" FontSize="14" Text="{Binding OpeningGraphName, StringFormat='Opening {0}…'}" />
        </Border>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorErrorsSplitter}" />
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedBottomTab}">
          <TabItem Header="Errors">
            <!-- Rows combine the live analysis and the last build's diagnostics (FR-032, US6);
                 double-click opens the graph and selects the node (FR-034, ED-T03). -->
            <ListBox x:Name="ErrorList" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorErrorList}" ItemsSource="{Binding ErrorList.Rows}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="ederrorlist:DiagnosticRowVM">
                  <StackPanel Orientation="Horizontal" Spacing="8" DoubleTapped="OnDiagnosticRowDoubleTapped">
                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorErrorId}" />
                    <TextBlock Text="{Binding Message}" />
                    <TextBlock Text="{Binding MemberName}" FontStyle="Italic" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
          <!-- Run's program output (stdout/stderr), captured on every platform instead of only going to the editor's own terminal. -->
          <TabItem Header="Output" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorOutputTab}">
            <DockPanel>
              <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Classes="flat" Content="Clear" Margin="2"
                      AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorClearOutputButton}" Command="{Binding ClearOutputCommand}" />
              <TextBox x:Name="OutputText" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorOutputText}" Text="{Binding Output}" IsReadOnly="True"
                       TextWrapping="NoWrap" AcceptsReturn="True" FontFamily="monospace" VerticalContentAlignment="Top"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
          </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorStatusText}" Grid.Row="3" Margin="4,2" Text="{Binding Project.CompilationMessage, FallbackValue=''}" />
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorInspectorSplitter}" />

      <!-- Inspectors (PAR-33..36) -->
      <Panel Grid.Column="4" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassEditorInspectorColumn}">
        <edinspectors:ClassInspectorView x:Name="ClassInspector" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassInspector}" IsVisible="{Binding ShowClassInspector}" />
        <!-- IsVisible on a wrapper, not the view itself, whose DataContext is overridden below (batch
             D1): avoids the multi-segment $parent[Window].DataContext.Show*Inspector path that logged a
             "Value is null" binding warning (owner report). -->
        <Panel IsVisible="{Binding ShowVariableInspector}">
          <edinspectors:VariableInspectorView x:Name="VariableInspector" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariableInspector}" DataContext="{Binding SelectedVariable}" />
        </Panel>
        <Panel IsVisible="{Binding ShowMethodInspector}">
          <edinspectors:MethodInspectorView x:Name="MethodInspector" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MethodInspector}" DataContext="{Binding SelectedMethod}" />
        </Panel>
      </Panel>
    </Grid>
  </Grid>
</Window>
