<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:NetPrints.Editor.Controls"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:edb="clr-namespace:NetPrints.Editor.Behaviors"
        xmlns:eddialogs="clr-namespace:NetPrints.Editor.Dialogs"
        xmlns:edlife="clr-namespace:NetPrints.Editor.Lifecycle"
        xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
        x:Class="NetPrints.Editor.Dialogs.UnsavedChangesDialog"
        x:DataType="eddialogs:UnsavedChangesDialogViewModel"
        Title="Unsaved changes"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.UnsavedDialog}">
  <Interaction.Behaviors>
    <edb:DialogCloseBehavior />
  </Interaction.Behaviors>
  <ctl:DialogShell Title="{Binding $parent[Window].Title}" IconId="{x:Static icons:IconIds.DialogWarning}">
    <ctl:DialogShell.Actions>
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.UnsavedCancelButton}" Content="Cancel" Classes="dialogAction" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.UnsavedDontSaveButton}" Content="Don't save" Classes="dialogAction" Command="{Binding DontSaveCommand}" />
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.UnsavedSaveAllButton}" Content="Save all" Classes="dialogAction accent" IsDefault="True" Command="{Binding SaveAllCommand}" />
    </ctl:DialogShell.Actions>
    <StackPanel Spacing="{StaticResource Space.S.Size}">
      <TextBlock Text="These files have changes that are not saved:" TextWrapping="Wrap" />
      <ListBox ItemsSource="{Binding Files}" MaxHeight="{StaticResource Dialog.ListMaxHeight}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.UnsavedFiles}"
               AutomationProperties.Name="Unsaved files">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="edlife:UnsavedFile">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </ctl:DialogShell>
</Window>
