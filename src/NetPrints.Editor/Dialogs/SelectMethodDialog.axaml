<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:NetPrints.Editor.Controls"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:edb="clr-namespace:NetPrints.Editor.Behaviors"
        xmlns:eddialogs="clr-namespace:NetPrints.Editor.Dialogs"
        xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
        x:Class="NetPrints.Editor.Dialogs.SelectMethodDialog"
        x:DataType="eddialogs:SelectMethodDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        Width="{StaticResource Dialog.MaxWidth}" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SelectMethodDialog}">
  <Interaction.Behaviors>
    <edb:DialogCloseBehavior />
  </Interaction.Behaviors>
  <ctl:DialogShell Title="{Binding $parent[Window].Title}" IconId="{x:Static icons:IconIds.CategoryMethod}">
    <ctl:DialogShell.Actions>
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SelectMethodCancelButton}" Content="Cancel" Classes="dialogAction" IsCancel="True" Command="{Binding List.CancelCommand}" />
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SelectMethodButton}" Content="{Binding AcceptLabel}" Classes="dialogAction accent" IsDefault="True" Command="{Binding List.PickCommand}" />
    </ctl:DialogShell.Actions>
    <ctl:MethodPickerList DataContext="{Binding List}" />
  </ctl:DialogShell>
</Window>
