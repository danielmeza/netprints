<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:NetPrints.Editor.Controls"
        xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:eddialogs="clr-namespace:NetPrints.Editor.Dialogs"
        x:Class="NetPrints.Editor.Dialogs.ErrorDialog"
        x:DataType="eddialogs:ErrorDialogViewModel"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ErrorDialog}">
  <ctl:DialogShell Title="{Binding $parent[Window].Title}" IconId="{x:Static icons:IconIds.DialogError}">
    <ctl:DialogShell.Actions>
      <!-- Closes the dialog with no result; no prebuilt tap-to-command behavior applies here (there is
           no VM command to run), so this is the ButtonClickEventTriggerBehavior + CloseWindowAction
           pair (D11, ADR-0007 batch X2b). -->
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ErrorOkButton}" Content="OK" Classes="dialogAction"
              IsDefault="True" IsCancel="True">
        <Interaction.Behaviors>
          <ButtonClickEventTriggerBehavior>
            <CloseWindowAction />
          </ButtonClickEventTriggerBehavior>
        </Interaction.Behaviors>
      </Button>
    </ctl:DialogShell.Actions>
    <!-- Read-only but selectable so the error can be copied. -->
    <TextBox AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ErrorMessage}" Classes="codeBlock"
             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="{StaticResource Dialog.ListMaxHeight}" Text="{Binding Message, Mode=OneWay}" />
  </ctl:DialogShell>
</Window>
