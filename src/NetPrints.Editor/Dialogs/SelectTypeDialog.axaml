<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:NetPrints.Editor.Controls"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:edb="clr-namespace:NetPrints.Editor.Behaviors"
        xmlns:eddialogs="clr-namespace:NetPrints.Editor.Dialogs"
        xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
        x:Class="NetPrints.Editor.Dialogs.SelectTypeDialog"
        x:DataType="eddialogs:SelectTypeDialogViewModel"
        Title="Select Type"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SelectTypeDialog}">
  <!-- Closes with the VM's result once it asks to (D16, ADR-0007 batch X2b). -->
  <Interaction.Behaviors>
    <edb:DialogCloseBehavior />
  </Interaction.Behaviors>
  <ctl:DialogShell Title="{Binding $parent[Window].Title}" IconId="{x:Static icons:IconIds.CategoryType}">
    <ctl:DialogShell.Actions>
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SelectTypeCancelButton}" Content="Cancel" Classes="dialogAction" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SelectTypeButton}" Content="Select" Classes="dialogAction Primary" Theme="{DynamicResource SolidButton}" IsDefault="True" Command="{Binding SelectCommand}" />
    </ctl:DialogShell.Actions>
    <!-- Editable chooser over the non-static types (PAR-58). -->
    <AutoCompleteBox x:Name="TypeBox" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.SelectTypeBox}" FilterMode="ContainsOrdinal" MinimumPrefixLength="1" MaxDropDownHeight="300"
                     PlaceholderText="Type name" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Text="{Binding TypedText}" />
  </ctl:DialogShell>
</Window>
