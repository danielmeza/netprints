<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:ctl="clr-namespace:NetPrints.Editor.Controls"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:edb="clr-namespace:NetPrints.Editor.Behaviors"
        xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
        x:Class="NetPrints.Editor.Dialogs.ExtensionDialog"
        x:DataType="sys:Object"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        SizeToContent="WidthAndHeight" MinWidth="320" CanResize="False"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ExtensionDialog}">
  <Interaction.Behaviors>
    <edb:DialogCloseBehavior />
  </Interaction.Behaviors>
  <ctl:DialogShell Title="{Binding $parent[Window].Title}" IconId="{x:Static icons:IconIds.DialogInfo}">
    <ctl:DialogShell.Actions>
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ExtensionDialogCloseButton}" Content="Close" Classes="dialogAction"
              IsDefault="True" IsCancel="True">
        <Interaction.Behaviors>
          <ButtonClickEventTriggerBehavior>
            <CloseWindowAction />
          </ButtonClickEventTriggerBehavior>
        </Interaction.Behaviors>
      </Button>
    </ctl:DialogShell.Actions>
    <ContentControl Content="{Binding}" />
  </ctl:DialogShell>
</Window>
