<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:edb="clr-namespace:NetPrints.Editor.Behaviors"
        xmlns:eddialogs="clr-namespace:NetPrints.Editor.Dialogs"
        xmlns:edlife="clr-namespace:NetPrints.Editor.Lifecycle"
        x:Class="NetPrints.Editor.Dialogs.RecoverDialog"
        x:DataType="eddialogs:RecoverDialogViewModel"
        Title="Recover unsaved work"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        Width="480" Height="300" CanResize="False"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.RecoverDialog}">
  <Interaction.Behaviors>
    <edb:DialogCloseBehavior />
  </Interaction.Behaviors>
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <TextBlock Text="The editor found backups of unsaved changes to these files:" TextWrapping="Wrap" Margin="0,0,0,8" />
    <ListBox Grid.Row="1" ItemsSource="{Binding Files}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.RecoverFiles}"
             AutomationProperties.Name="Backed-up files">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="edlife:RecoveryFile">
          <StackPanel>
            <TextBlock Text="{Binding Path}" />
            <TextBlock Text="Older than the file on disk" IsVisible="{Binding IsOlderThanFile}" FontStyle="Italic" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.RecoverDiscardButton}" Content="Discard" MinWidth="80" IsDefault="{Binding DiscardIsDefault}" Command="{Binding DiscardCommand}" />
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.RecoverRestoreButton}" Content="Restore" MinWidth="80" Classes="accent" IsDefault="{Binding RestoreIsDefault}" Command="{Binding RestoreCommand}" />
    </StackPanel>
  </Grid>
</Window>
