<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:NetPrints.Editor.Controls"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:edb="clr-namespace:NetPrints.Editor.Behaviors"
        xmlns:eddialogs="clr-namespace:NetPrints.Editor.Dialogs"
        xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
        x:Class="NetPrints.Editor.Dialogs.ConfirmDialog"
        x:DataType="eddialogs:ConfirmDialogViewModel"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ConfirmDialog}">
  <Interaction.Behaviors>
    <edb:DialogCloseBehavior />
  </Interaction.Behaviors>
  <ctl:DialogShell Title="{Binding $parent[Window].Title}" IconId="{x:Static icons:IconIds.DialogConfirm}">
    <ctl:DialogShell.Actions>
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ConfirmCancelButton}" Content="Cancel" Classes="dialogAction" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ConfirmButton}" Content="{Binding ConfirmLabel}" Classes="dialogAction accent" IsDefault="True" Command="{Binding ConfirmCommand}" />
    </ctl:DialogShell.Actions>
    <TextBlock TextWrapping="Wrap" Text="{Binding Message}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ConfirmMessage}" />
  </ctl:DialogShell>
</Window>
