<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:edb="clr-namespace:NetPrints.Editor.Behaviors"
        xmlns:eddialogs="clr-namespace:NetPrints.Editor.Dialogs"
        x:Class="NetPrints.Editor.Dialogs.ConfirmDialog"
        x:DataType="eddialogs:ConfirmDialogViewModel"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        Width="440" Height="170" CanResize="False"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ConfirmDialog}">
  <Interaction.Behaviors>
    <edb:DialogCloseBehavior />
  </Interaction.Behaviors>
  <Grid RowDefinitions="*,Auto" Margin="12">
    <TextBlock TextWrapping="Wrap" Text="{Binding Message}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ConfirmMessage}" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ConfirmCancelButton}" Content="Cancel" MinWidth="80" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ConfirmButton}" Content="{Binding ConfirmLabel}" MinWidth="80" Classes="accent" IsDefault="True" Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </Grid>
</Window>
