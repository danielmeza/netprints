<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u-semi="using:Ursa.Themes.Semi"
             x:Class="NetPrints.Editor.EditorApp"
             Name="NetPrints"
             RequestedThemeVariant="Dark">
  <!-- The built-in view templates are added through the editor facet (BuiltInViews.axaml, ViewResourceLoader). -->
  <Application.Styles>
    <FluentTheme />
    <semi:SemiTheme Locale="en-US" />
    <u-semi:UrsaSemiTheme Locale="en-US"/>
    <!-- Nodify control templates; without them no graph item is realized. -->
    <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml" />
    <!-- The code view's AvaloniaEdit TextEditor (research.md R2). -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <mi:MaterialIconStyles />
    <StyleInclude Source="avares://NetPrints.Editor/EditorStyles.axaml" />
    <StyleInclude Source="avares://NetPrints.Editor/Icons/IconPresenter.axaml" />
    <StyleInclude Source="avares://NetPrints.Editor/Icons/AppMark.axaml" />
    <StyleInclude Source="avares://NetPrints.Editor/Shell/Docking/DockStyles.axaml" />
  </Application.Styles>
</Application>
