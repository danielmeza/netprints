<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:spike="clr-namespace:NetPrints.Editor.Shell.Docking.Spike"
             xmlns:ederrorlist="clr-namespace:NetPrints.Editor.ErrorList"
             x:Class="NetPrints.Editor.EditorApp"
             Name="NetPrints"
             RequestedThemeVariant="Dark">
  <!-- Floating dock windows resolve their content through the application's templates, not the DockControl's (ADR-0018 check 3). -->
  <Application.DataTemplates>
    <DataTemplate DataType="spike:SpikeDocument" x:DataType="spike:SpikeDocument">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
    <DataTemplate DataType="spike:SpikeTool" x:DataType="spike:SpikeTool">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
    <DataTemplate DataType="ederrorlist:DiagnosticRowViewModel" x:DataType="ederrorlist:DiagnosticRowViewModel">
      <StackPanel Margin="8" Spacing="4">
        <TextBlock Text="{Binding Id}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.DockSpikeContentId}" />
        <TextBlock Text="{Binding Message}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.DockSpikeContentMessage}" />
      </StackPanel>
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Emerald accent and dark grey surfaces (MahApps Dark.Emerald of the WPF editor: #252525
             window, #2B2B2B panels), instead of Fluent's default near-black. -->
        <ColorPaletteResources x:Key="Dark" Accent="#FF008A00"
                                RegionColor="#FF252525" AltHigh="#FF252525" AltMediumHigh="#FF2B2B2B" AltMedium="#FF2B2B2B" AltMediumLow="#FF333333"
                                ChromeLow="#FF2B2B2B" ChromeMedium="#FF333333" ChromeMediumLow="#FF3A3A3A" ChromeHigh="#FF454545" />
        <ColorPaletteResources x:Key="Light" Accent="#FF008A00" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Nodify control templates; without them no graph item is realized. -->
    <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml" />
    <!-- The code view's AvaloniaEdit TextEditor (research.md R2). -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <mi:MaterialIconStyles />
    <StyleInclude Source="avares://NetPrints.Editor/EditorStyles.axaml" />
    <StyleInclude Source="avares://NetPrints.Editor/Shell/Docking/DockStyles.axaml" />
  </Application.Styles>
</Application>
