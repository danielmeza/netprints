<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetPrints.Editor</RootNamespace>
    <WarningsAsErrors>$(WarningsAsErrors);CA1848;CA2254</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <NetPrintsExperimentalOptIn Include="NPXE0001" />
    <NetPrintsExperimentalOptIn Include="NPXE0002" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- The graph grid draws on the leased SKCanvas (GridBackground). -->
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Nodify.Avalonia" />
    <!-- The code view (research.md R2): TextMateSharp.Grammars flows in transitively (pinned via its
         own version, no override) for RegistryOptions/ThemeName. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="Semi.Avalonia" />
    <!-- ADR-0007: prebuilt behaviors before code-behind or a custom behavior (avalonia-behaviors skill, D11). -->
    <PackageReference Include="Xaml.Behaviors.Interactions" />
    <PackageReference Include="Xaml.Behaviors.Interactions.Custom" />
    <PackageReference Include="Xaml.Behaviors.Interactions.DragAndDrop" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- ADR-0018: used only under Shell/Docking (DockConfinementTests). -->
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="DynamicData" />
    <!-- Used directly by the search list (Throttle, schedulers), not only through DynamicData. -->
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <!-- Transitively pulled in by the NetPrints.Workspace project reference (MsBuildProjectSystem);
         ExcludeAssets/PrivateAssets satisfies MSBuildLocator's own MSBL001 guard (research K10) here
         too, since NuGet surfaces them as PackageReference items of this project as well. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetPrints.Catalog\NetPrints.Catalog.csproj" />
    <ProjectReference Include="..\NetPrints.Core\NetPrints.Core.csproj" />
    <ProjectReference Include="..\NetPrints.Extensibility\NetPrints.Extensibility.csproj" />
    <ProjectReference Include="..\NetPrints.Reflection\NetPrints.Reflection.csproj" />
    <ProjectReference Include="..\NetPrints.Serialization\NetPrints.Serialization.csproj" />
    <ProjectReference Include="..\NetPrints.Workspace\NetPrints.Workspace.csproj" />
    <!-- ProjectSessionViewModel calls NetPrints.Generation.GraphCodeGenerator directly: a normal
         ProjectReference to the shared library, not to the NetPrints.Generator exe (ADR-0009 supersedes
         the ADR-0005 ReferenceOutputAssembly=false + HintPath workaround, which broke a RID-published
         build, NETSDK1067/1150/1151/CS0234, and could silently compile against a stale DLL). -->
    <ProjectReference Include="..\NetPrints.Generation\NetPrints.Generation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="StartPage\WhatsNew.md" LogicalName="NetPrints.Editor.StartPage.WhatsNew.md" />
    <EmbeddedResource Include="Graph\GridShader.sksl" LogicalName="NetPrints.Editor.Graph.GridShader.sksl" />
  </ItemGroup>

  <!-- ADR-0022: the latest released version (nearest v* tag) is stamped into the assembly, so a build
       between releases writes a version that exists on nuget.org. No git or no tag: nothing is stamped. -->
  <Target Name="StampLatestRelease" BeforeTargets="GetAssemblyAttributes;GenerateAssemblyInfo">
    <Exec Command="git describe --tags --abbrev=0 --match &quot;v[0-9]*&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_LatestReleaseTag" />
      <Output TaskParameter="ExitCode" PropertyName="_LatestReleaseExit" />
    </Exec>
    <PropertyGroup>
      <_LatestRelease Condition="'$(_LatestReleaseExit)' == '0'">$([System.Text.RegularExpressions.Regex]::Replace('$(_LatestReleaseTag.Trim())', '^v', ''))</_LatestRelease>
    </PropertyGroup>
    <ItemGroup Condition="'$(_LatestRelease)' != ''">
      <AssemblyMetadata Include="NetPrints.LatestRelease" Value="$(_LatestRelease)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="NetPrints.Editor.Tests" />
    <InternalsVisibleTo Include="NetPrints.Editor.UITests" />
  </ItemGroup>
</Project>
