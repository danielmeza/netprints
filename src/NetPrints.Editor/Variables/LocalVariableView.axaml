<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:edvariables="clr-namespace:NetPrints.Editor.Variables"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NetPrints.Editor.Variables.LocalVariableView"
             x:DataType="edvariables:LocalVariableViewModel">
  <Grid ColumnDefinitions="120,*" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariableRow}" AutomationProperties.Name="{Binding Name}" Margin="0,0,0,4">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
      <Button Classes="icon" ToolTip.Tip="Remove local variable" AutomationProperties.Name="Remove local variable" Command="{Binding RemoveCommand}">
        <mi:MaterialIcon Kind="Minus" />
      </Button>
      <TextBlock Text="Name" Foreground="Gray" VerticalAlignment="Center" Margin="4,0,0,0" />
    </StackPanel>
    <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
      <TextBox x:Name="NameBox" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariableName}" 
               Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
      <Button Grid.Column="1" Classes="flat" Content="{Binding Type.ShortName}" ToolTip.Tip="Change type" Command="{Binding RetypeCommand}" Margin="4,0,0,0" />
    </Grid>
  </Grid>
</UserControl>
