<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:edvariables="clr-namespace:NetPrints.Editor.Variables"
             xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
             x:Class="NetPrints.Editor.Variables.VariablesPanelView"
             x:DataType="edvariables:ShellVariablesPanelViewModel">
  <!-- The member variables of the active class, and the local variables of the active method: compact rows, "+" in the header, selection shows the inspector.
       One scroll viewer holds both lists, which grow with their rows (a class has tens of variables, not thousands). -->
  <Panel>
    <TextBlock Margin="{StaticResource Space.S}" TextWrapping="Wrap" Text="Open a graph to see the variables of its class."
               IsVisible="{Binding Current, Converter={x:Static ObjectConverters.IsNull}}"
               AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariablesEmpty}" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Current}"
                  IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel x:DataType="edvariables:VariablesPanelViewModel">
        <StackPanel AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariablesClassGroup}">
          <Grid ColumnDefinitions="*,Auto" Classes="sectionHeaderRow">
            <TextBlock Classes="sectionHeader" Text="Variables" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding CreateVariableCommand}" ToolTip.Tip="Add variable" AutomationProperties.Name="Add variable"
                    AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariablesAddVariable}">
              <icons:IconPresenter IconId="{x:Static icons:IconIds.Add}" />
            </Button>
          </Grid>
          <ListBox Classes="variableList" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding ClassVariables}"
                   SelectedItem="{Binding SelectedClassVariable}">
            <ListBox.KeyBindings>
              <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedClassVariableCommand}" />
              <KeyBinding Gesture="F2" Command="{Binding RenameSelectedClassVariableCommand}" />
            </ListBox.KeyBindings>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="edvariables:MemberVariableViewModel">
                <edvariables:VariableRowView />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <StackPanel IsVisible="{Binding HasMethodGroup}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariablesMethodGroup}">
          <Grid ColumnDefinitions="*,Auto" Classes="sectionHeaderRow spaced">
            <TextBlock Classes="sectionHeader" Text="{Binding MethodGroupHeader}" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding CreateLocalVariableCommand}" ToolTip.Tip="Add local variable" AutomationProperties.Name="Add local variable"
                    AutomationProperties.AutomationId="{x:Static ed:AutomationIds.VariablesAddLocalVariable}">
              <icons:IconPresenter IconId="{x:Static icons:IconIds.Add}" />
            </Button>
          </Grid>
          <ListBox Classes="variableList" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding MethodVariables}"
                   SelectedItem="{Binding SelectedLocalVariable}">
            <ListBox.KeyBindings>
              <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedLocalVariableCommand}" />
              <KeyBinding Gesture="F2" Command="{Binding RenameSelectedLocalVariableCommand}" />
            </ListBox.KeyBindings>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="edvariables:LocalVariableViewModel">
                <edvariables:VariableRowView />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
