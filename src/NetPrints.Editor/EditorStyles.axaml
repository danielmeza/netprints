<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
        xmlns:nodify="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia"
        xmlns:nc="clr-namespace:Nodify.Avalonia.Connections;assembly=Nodify.Avalonia"
        xmlns:nn="clr-namespace:Nodify.Avalonia.Nodes;assembly=Nodify.Avalonia">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Nodify control themes (FR-086): the defaults, re-coloured from tokens. A view applies one with Theme=. -->
      <ControlTheme x:Key="NetPrints.SelectionRectangle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Canvas.MarqueeFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Canvas.MarqueeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
      </ControlTheme>
      <ControlTheme x:Key="NetPrints.NodifyEditor" TargetType="nodify:NodifyEditor" BasedOn="{StaticResource {x:Type nodify:NodifyEditor}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SelectionRectangleTheme" Value="{StaticResource NetPrints.SelectionRectangle}" />
      </ControlTheme>
      <ControlTheme x:Key="NetPrints.ItemContainer" TargetType="nodify:ItemContainer" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HighlightBrush" Value="Transparent" />
        <Setter Property="SelectedBrush" Value="Transparent" />
      </ControlTheme>
      <ControlTheme x:Key="NetPrints.Node" TargetType="nn:Node" BasedOn="{StaticResource {x:Type nn:Node}}">
        <Setter Property="Background" Value="{DynamicResource Node.CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Node.Border}" />
        <Setter Property="HeaderBrush" Value="{DynamicResource Node.Header.Flow}" />
        <Setter Property="Foreground" Value="{DynamicResource Node.TitleForeground}" />
      </ControlTheme>
      <ControlTheme x:Key="NetPrints.Connection" TargetType="nc:Connection" BasedOn="{StaticResource {x:Type nc:Connection}}">
        <Setter Property="Stroke" Value="{DynamicResource Pin.Data}" />
        <Setter Property="StrokeThickness" Value="4" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="StrokeLineCap" Value="Round" />
      </ControlTheme>
      <ControlTheme x:Key="NetPrints.Connector" TargetType="nc:Connector" BasedOn="{StaticResource {x:Type nc:Connector}}">
        <Setter Property="Foreground" Value="{DynamicResource Pin.Data}" />
      </ControlTheme>
      <!-- Type ramp, spacing scale and shared widths (FR-080, research R11); none of these vary by theme. -->
      <x:Double x:Key="Font.Caption">12</x:Double>
      <x:Double x:Key="Font.Body">14</x:Double>
      <x:Double x:Key="Font.Subtitle">16</x:Double>
      <x:Double x:Key="Font.Title">20</x:Double>
      <x:Double x:Key="Font.Watermark">32</x:Double>
      <FontFamily x:Key="Font.Mono">avares://NetPrints.Editor/Assets/Fonts#Cascadia Mono</FontFamily>
      <Thickness x:Key="Space.XS">4</Thickness>
      <Thickness x:Key="Space.S">8</Thickness>
      <Thickness x:Key="Space.M">12</Thickness>
      <Thickness x:Key="Space.L">16</Thickness>
      <Thickness x:Key="Space.XL">24</Thickness>
      <x:Double x:Key="Space.XS.Size">4</x:Double>
      <x:Double x:Key="Space.S.Size">8</x:Double>
      <x:Double x:Key="Space.M.Size">12</x:Double>
      <x:Double x:Key="Space.L.Size">16</x:Double>
      <x:Double x:Key="Space.XL.Size">24</x:Double>
      <GridLength x:Key="Inspector.LabelColumnWidth">120</GridLength>
      <x:Double x:Key="Icon.Small">16</x:Double>
      <x:Double x:Key="Icon.Medium">20</x:Double>
      <!-- Interaction (FR-087): the ring, the shared corner radius and the density tokens. -->
      <Thickness x:Key="Focus.RingThickness">2</Thickness>
      <CornerRadius x:Key="Radius.Control">4</CornerRadius>
      <x:Double x:Key="Density.RowHeight">24</x:Double>
      <Thickness x:Key="Density.RowPadding">8,2</Thickness>
      <x:Double x:Key="Density.CommandBarHeight">36</x:Double>
      <!-- Motion (FR-087): every transition takes its duration and easing from here, so netprints.enableAnimations switches them all off. -->
      <x:TimeSpan x:Key="Motion.Fast">0:0:0.1</x:TimeSpan>
      <x:TimeSpan x:Key="Motion.Normal">0:0:0.15</x:TimeSpan>
      <CubicEaseOut x:Key="Motion.Easing" />
      <FocusAdornerTemplate x:Key="NetPrints.FocusAdorner">
        <Border BorderThickness="{StaticResource Focus.RingThickness}" BorderBrush="{DynamicResource Focus.Ring}"
                CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False" />
      </FocusAdornerTemplate>
      <!-- Graph canvas grid (spec 002): lines white on dark, black on light; minor 8% and major 18% alpha.
           The canvas background is SystemRegionColor (EditorApp.axaml palette). -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Focus.Ring">#4FC3F7</SolidColorBrush>
          <SolidColorBrush x:Key="State.Hover">#26FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="State.Pressed">#3DFFFFFF</SolidColorBrush>
          <Color x:Key="GraphGrid.MinorColor">#14FFFFFF</Color>
          <Color x:Key="GraphGrid.MajorColor">#2EFFFFFF</Color>
          <SolidColorBrush x:Key="GraphWatermark.Foreground">#CCEEEEEE</SolidColorBrush>
          <SolidColorBrush x:Key="Node.CardBackground">#AA202020</SolidColorBrush>
          <BoxShadows x:Key="Node.CardShadow">4 4 8 0 #80000000</BoxShadows>
          <SolidColorBrush x:Key="Node.TitleForeground">#FFEEEEEE</SolidColorBrush>
          <SolidColorBrush x:Key="Node.SubtitleForeground">#FFEEEEEE</SolidColorBrush>
          <SolidColorBrush x:Key="OpeningGraphIndicator.Background">#CC202020</SolidColorBrush>
          <SolidColorBrush x:Key="OpeningGraphIndicator.Foreground">White</SolidColorBrush>
          <SolidColorBrush x:Key="BusyOverlay.Background">#AA000000</SolidColorBrush>
          <BoxShadows x:Key="Popup.Shadow">0 4 12 0 #40000000</BoxShadows>
          <!-- Pin hover stroke (PAR-43, R2-07): white reads fine over the dark card, invisible over Light. -->
          <SolidColorBrush x:Key="Pin.HoverStroke">White</SolidColorBrush>
          <!-- Error-list row severity icon (FR-032, OWN-03, owner report). -->
          <SolidColorBrush x:Key="Diagnostic.Error.Foreground">#FF6666</SolidColorBrush>
          <SolidColorBrush x:Key="Diagnostic.Warning.Foreground">#FFB74D</SolidColorBrush>
          <SolidColorBrush x:Key="Diagnostic.Info.Foreground">#64B5F6</SolidColorBrush>
          <!-- Command bar compile button: the error count badge. -->
          <SolidColorBrush x:Key="CommandBar.BadgeBackground">#C62828</SolidColorBrush>
          <SolidColorBrush x:Key="CommandBar.BadgeForeground">White</SolidColorBrush>
          
          <!-- Domain Colors -->
          <SolidColorBrush x:Key="Icon.Method.Foreground">#B388FF</SolidColorBrush>
          <SolidColorBrush x:Key="Icon.Property.Foreground">#81D4FA</SolidColorBrush>
          <SolidColorBrush x:Key="Icon.Event.Foreground">#FFCDD2</SolidColorBrush>
          <SolidColorBrush x:Key="Icon.Class.Foreground">#A5D6A7</SolidColorBrush>

          <!-- Node header roles (FR-086): each against Node.HeaderForeground reaches 4.5:1. -->
          <SolidColorBrush x:Key="Node.HeaderForeground">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Entry">#3F3FA3</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Call">#2A5C8C</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Pure">#2E7A3F</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Flow">#5A5A5A</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Variable">#1F7A7A</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Constructor">#8A5A00</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Async">#6B3FA0</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Throw">#B3261E</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Border">#CC303030</SolidColorBrush>
          <!-- Pin kinds and data-type categories (FR-086). -->
          <SolidColorBrush x:Key="Pin.Exec">#E0FFE0</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Data">#E0E0FF</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Type">#FFE0E0</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Bool">#EF5350</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Integer">#26C6DA</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Float">#66BB6A</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.String">#F06292</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Object">#90A4AE</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.ValueType">#FFB74D</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Delegate">#BA68C8</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Generic">#4DB6AC</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.DefaultValue">#10EEFF</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Hint">#FFB0B0B0</SolidColorBrush>
          <!-- Selection, marquee and selected wire (FR-086). -->
          <SolidColorBrush x:Key="Canvas.SelectionBorder">#4FC3F7</SolidColorBrush>
          <SolidColorBrush x:Key="Canvas.MarqueeFill">#334FC3F7</SolidColorBrush>
          <SolidColorBrush x:Key="Canvas.MarqueeBorder">#4FC3F7</SolidColorBrush>
          <SolidColorBrush x:Key="Canvas.WireSelected">#FFD54F</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Focus.Ring">#0277BD</SolidColorBrush>
          <SolidColorBrush x:Key="State.Hover">#14000000</SolidColorBrush>
          <SolidColorBrush x:Key="State.Pressed">#26000000</SolidColorBrush>
          <Color x:Key="GraphGrid.MinorColor">#14000000</Color>
          <Color x:Key="GraphGrid.MajorColor">#2E000000</Color>
          <SolidColorBrush x:Key="GraphWatermark.Foreground">#55202020</SolidColorBrush>
          <SolidColorBrush x:Key="Node.CardBackground">#AAF0F0F0</SolidColorBrush>
          <BoxShadows x:Key="Node.CardShadow">2 2 6 0 #40000000</BoxShadows>
          <SolidColorBrush x:Key="Node.TitleForeground">#FF202020</SolidColorBrush>
          <SolidColorBrush x:Key="Node.SubtitleForeground">#FF202020</SolidColorBrush>
          <SolidColorBrush x:Key="OpeningGraphIndicator.Background">#CCF5F5F5</SolidColorBrush>
          <SolidColorBrush x:Key="OpeningGraphIndicator.Foreground">#FF202020</SolidColorBrush>
          <SolidColorBrush x:Key="BusyOverlay.Background">#66000000</SolidColorBrush>
          <BoxShadows x:Key="Popup.Shadow">0 4 12 0 #30000000</BoxShadows>
          <SolidColorBrush x:Key="Pin.HoverStroke">Black</SolidColorBrush>
          <!-- Error-list row severity icon (FR-032, OWN-03, owner report). -->
          <SolidColorBrush x:Key="Diagnostic.Error.Foreground">#C62828</SolidColorBrush>
          <SolidColorBrush x:Key="Diagnostic.Warning.Foreground">#E65100</SolidColorBrush>
          <SolidColorBrush x:Key="Diagnostic.Info.Foreground">#1565C0</SolidColorBrush>
          <SolidColorBrush x:Key="CommandBar.BadgeBackground">#C62828</SolidColorBrush>
          <SolidColorBrush x:Key="CommandBar.BadgeForeground">White</SolidColorBrush>
          
          <!-- Domain Colors -->
          <SolidColorBrush x:Key="Icon.Method.Foreground">#7E57C2</SolidColorBrush>
          <SolidColorBrush x:Key="Icon.Property.Foreground">#29B6F6</SolidColorBrush>
          <SolidColorBrush x:Key="Icon.Event.Foreground">#EF5350</SolidColorBrush>
          <SolidColorBrush x:Key="Icon.Class.Foreground">#66BB6A</SolidColorBrush>

          <SolidColorBrush x:Key="Node.HeaderForeground">#FF1A1A1A</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Entry">#C5CAF5</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Call">#BBD7F2</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Pure">#C2E6C8</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Flow">#D4D4D4</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Variable">#B6E3E3</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Constructor">#F0D9A8</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Async">#DCC8F0</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Header.Throw">#F5B8B3</SolidColorBrush>
          <SolidColorBrush x:Key="Node.Border">#CCB0B0B0</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Exec">#2E7D32</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Data">#3949AB</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Type">#C62828</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Bool">#D32F2F</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Integer">#00838F</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Float">#388E3C</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.String">#C2185B</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Object">#546E7A</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.ValueType">#EF6C00</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Delegate">#7B1FA2</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Generic">#00796B</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.DefaultValue">#0097A7</SolidColorBrush>
          <SolidColorBrush x:Key="Pin.Hint">#FF5A5A5A</SolidColorBrush>
          <SolidColorBrush x:Key="Canvas.SelectionBorder">#0277BD</SolidColorBrush>
          <SolidColorBrush x:Key="Canvas.MarqueeFill">#330277BD</SolidColorBrush>
          <SolidColorBrush x:Key="Canvas.MarqueeBorder">#0277BD</SolidColorBrush>
          <SolidColorBrush x:Key="Canvas.WireSelected">#F57F17</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Error-list row severity icon color (FR-032, OWN-03): the icon's class is set from
       DiagnosticRowViewModel.Is{Error,Warning,Info} (Classes.<name>="{Binding ...}"), the state→visual mapping
       this style then turns into a themed color. -->
  <Style Selector="icons|IconPresenter.error">
    <Setter Property="Foreground" Value="{DynamicResource Diagnostic.Error.Foreground}" />
  </Style>
  <Style Selector="icons|IconPresenter.warning">
    <Setter Property="Foreground" Value="{DynamicResource Diagnostic.Warning.Foreground}" />
  </Style>
  <Style Selector="icons|IconPresenter.info">
    <Setter Property="Foreground" Value="{DynamicResource Diagnostic.Info.Foreground}" />
  </Style>

  <!-- Domain icon colors -->
  <Style Selector="icons|IconPresenter[IconId='netprints.icon.class']">
    <Setter Property="Foreground" Value="{DynamicResource Icon.Class.Foreground}" />
  </Style>
  <Style Selector="icons|IconPresenter[IconId='netprints.icon.method']">
    <Setter Property="Foreground" Value="{DynamicResource Icon.Method.Foreground}" />
  </Style>
  <Style Selector="icons|IconPresenter[IconId='netprints.icon.constructor']">
    <Setter Property="Foreground" Value="{DynamicResource Icon.Method.Foreground}" />
  </Style>
  <Style Selector="icons|IconPresenter[IconId='netprints.icon.variable']">
    <Setter Property="Foreground" Value="{DynamicResource Icon.Property.Foreground}" />
  </Style>
  <Style Selector="icons|IconPresenter[IconId='netprints.icon.event']">
    <Setter Property="Foreground" Value="{DynamicResource Icon.Event.Foreground}" />
  </Style>

  <!-- Node headers: the role class (NodeRole.StyleClass) picks the colour token; the text follows the variant (FR-086). -->
  <Style Selector="Border.nodeHeader.role-entry">
    <Setter Property="Background" Value="{DynamicResource Node.Header.Entry}" />
  </Style>
  <Style Selector="Border.nodeHeader.role-call">
    <Setter Property="Background" Value="{DynamicResource Node.Header.Call}" />
  </Style>
  <Style Selector="Border.nodeHeader.role-pure">
    <Setter Property="Background" Value="{DynamicResource Node.Header.Pure}" />
  </Style>
  <Style Selector="Border.nodeHeader.role-flow">
    <Setter Property="Background" Value="{DynamicResource Node.Header.Flow}" />
  </Style>
  <Style Selector="Border.nodeHeader.role-variable">
    <Setter Property="Background" Value="{DynamicResource Node.Header.Variable}" />
  </Style>
  <Style Selector="Border.nodeHeader.role-constructor">
    <Setter Property="Background" Value="{DynamicResource Node.Header.Constructor}" />
  </Style>
  <Style Selector="Border.nodeHeader.role-async">
    <Setter Property="Background" Value="{DynamicResource Node.Header.Async}" />
  </Style>
  <Style Selector="Border.nodeHeader.role-throw">
    <Setter Property="Background" Value="{DynamicResource Node.Header.Throw}" />
  </Style>
  <Style Selector="Border.nodeHeader TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Node.HeaderForeground}" />
  </Style>
  <Style Selector="Border.nodeHeader icons|IconPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Node.HeaderForeground}" />
  </Style>

  <!-- Node card: the border is the selection mark. -->
  <Style Selector="Border.nodeCard">
    <Setter Property="BorderBrush" Value="{DynamicResource Node.Border}" />
  </Style>
  <Style Selector="Border.nodeCard.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Canvas.SelectionBorder}" />
  </Style>

  <!-- Pins and cables by kind; an unconnected pin is drawn at 60 % (PAR-43). -->
  <Style Selector=":is(Shape).pin-exec">
    <Setter Property="Fill" Value="{DynamicResource Pin.Exec}" />
  </Style>
  <Style Selector=":is(Shape).pin-data">
    <Setter Property="Fill" Value="{DynamicResource Pin.Data}" />
  </Style>
  <Style Selector=":is(Shape).pin-type">
    <Setter Property="Fill" Value="{DynamicResource Pin.Type}" />
  </Style>
  <Style Selector=":is(Shape).pin.dimmed">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.pinHint">
    <Setter Property="Foreground" Value="{DynamicResource Pin.Hint}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Polygon.defaultValue">
    <Setter Property="Fill" Value="{DynamicResource Pin.DefaultValue}" />
  </Style>
  <Style Selector="Polygon.defaultValue.inactive">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="nc|Connection.pin-exec">
    <Setter Property="Stroke" Value="{DynamicResource Pin.Exec}" />
  </Style>
  <Style Selector="nc|Connection.pin-data">
    <Setter Property="Stroke" Value="{DynamicResource Pin.Data}" />
  </Style>
  <Style Selector="nc|Connection.pin-type">
    <Setter Property="Stroke" Value="{DynamicResource Pin.Type}" />
  </Style>
  <Style Selector="nc|Connection:selected">
    <Setter Property="Stroke" Value="{DynamicResource Canvas.WireSelected}" />
  </Style>

  <!-- Output panel: a line of the program's standard error. -->
  <Style Selector="TextBlock.outputError">
    <Setter Property="Foreground" Value="{DynamicResource Diagnostic.Error.Foreground}" />
  </Style>

  <!-- Inspector fields: the message of a refused edit. -->
  <Style Selector="TextBlock.fieldError">
    <Setter Property="Foreground" Value="{DynamicResource Diagnostic.Error.Foreground}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Round toolbar buttons (MahApps MetroCircleButtonStyle in the WPF editor). -->
  <Style Selector="Button.round">
    <Setter Property="Width" Value="100" />
    <Setter Property="Height" Value="100" />
    <Setter Property="CornerRadius" Value="50" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <!-- Little padding, so the longest label ("References") fits the 100-px circle. -->
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
  </Style>

  <!-- Small round icon buttons (remove, +/-). -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <!-- Breadcrumbs above a graph (FR-065): flat 24 px buttons separated by a chevron. -->
  <Style Selector="Button.breadcrumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.breadcrumbSeparator">
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.header">
    <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="{StaticResource Space.XS}" />
  </Style>

  <!-- Command bar (contracts/commands.md section 1): a compact icon and label button, at most 40 px high with its bar. -->
  <Style Selector="Button.command-bar">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  
  <Style Selector="Button.command-bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource State.Hover}" />
  </Style>
  <Style Selector="Button.command-bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource State.Pressed}" />
  </Style>

  <!-- Keyboard focus ring and hover and pressed states (FR-087): the ring follows Radius.Control, the states are tokens. -->
  <Style Selector="TreeViewItem, ListBoxItem, MenuItem, TextBox, Button.command-bar">
    <Setter Property="FocusAdorner" Value="{StaticResource NetPrints.FocusAdorner}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
  </Style>
  <!-- Hover and pressed backgrounds fade over Motion.Fast. -->
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="{x:Static ContentPresenter.BackgroundProperty}" Duration="{StaticResource Motion.Fast}" Easing="{StaticResource Motion.Easing}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="{x:Static Border.BackgroundProperty}" Duration="{StaticResource Motion.Fast}" Easing="{StaticResource Motion.Easing}" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Row density: tree items, the Errors and Output rows and the quick-pick rows share one height and padding. -->
  <Style Selector="TreeView TreeViewItem, ListBox.rows ListBoxItem, ListBox.quickPick ListBoxItem">
    <Setter Property="MinHeight" Value="{StaticResource Density.RowHeight}" />
    <Setter Property="Padding" Value="{StaticResource Density.RowPadding}" />
  </Style>

  <!-- Palette and node-search popups fade in over Motion.Normal: the root starts transparent and a Loaded trigger adds .shown. -->
  <Style Selector=":is(Control).popupFade">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{StaticResource Motion.Normal}" Easing="{StaticResource Motion.Easing}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).popupFade.shown">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TreeViewItem:not(:selected) /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource State.Hover}" />
  </Style>
  <Style Selector="TreeViewItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource State.Pressed}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource State.Hover}" />
  </Style>
  <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource State.Pressed}" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource State.Hover}" />
  </Style>
  <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource State.Pressed}" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource CommandBar.BadgeBackground}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CommandBar.BadgeForeground}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <!-- Type ramp for text roles: a view picks a class and never sets FontSize (rule E8). -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="42" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="TextBlock.treeItem">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.nodeTitle">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.pinLabel">
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox.pinLabel">
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.memberName">
    <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.inspectorLabel">
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,4" />
  </Style>
  <!-- Inspector property grid: label column Auto, editors share one row rhythm (the inspectorLabel bottom margin). -->
  <Style Selector="Grid.propertyGrid > :is(TextBox)">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Grid.propertyGrid > :is(ComboBox)">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Grid.propertyGrid > :is(StackPanel)">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Grid.propertyGrid > :is(CheckBox)">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0" />
  </Style>

  <!-- Dialogs: root grid, header, footer buttons and a read-only code-like text box. -->
  <Style Selector="Grid.dialogRoot">
    <Setter Property="Margin" Value="12" />
    <Setter Property="RowSpacing" Value="12" />
  </Style>
  <Style Selector="TextBlock.dialogTitle">
    <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.groupTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,4" />
  </Style>
  <Style Selector="Button.dialogAction">
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBox.codeBlock">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <!-- Monospace font with tabular (fixed-width) numerals. -->
  <Style Selector="TextBlock.tabular">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>
  <Style Selector="TextBox.tabular">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>

  <!-- Search box flush with its popup. -->
  <Style Selector="Grid.quickPickRow.disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="TextBox.searchInput">
    <Setter Property="Margin" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Settings forms. -->
  <Style Selector="StackPanel.formContainer">
    <Setter Property="Margin" Value="16" />
    <Setter Property="Spacing" Value="4" />
    <Setter Property="MaxWidth" Value="480" />
  </Style>
  <Style Selector="TextBlock.formLabel">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4" />
  </Style>
  <Style Selector="ComboBox.formInput">
    <Setter Property="Margin" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Key hint next to a menu item. -->
  <Style Selector="TextBlock.menuShortcut">
    <Setter Property="Margin" Value="24,0,0,0" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
</Styles>
