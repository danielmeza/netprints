<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:edmain="clr-namespace:NetPrints.Editor.Main"
        xmlns:core="clr-namespace:NetPrints.Core;assembly=NetPrints"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="NetPrints.Editor.Main.MainWindow"
        x:DataType="edmain:MainEditorVM"
        Title="{Binding Title}"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        Width="800" Height="600" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainWindow}">
  <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="5">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ProjectButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainProjectButton}" Classes="round" Content="Project" Command="{Binding ToggleProjectPaneCommand}" />
        <Button x:Name="ReferencesButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainReferencesButton}" Classes="round" Content="References" Command="{Binding ShowReferencesCommand}" />
        <Button x:Name="SettingsButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainSettingsButton}" Classes="round" Content="Settings" Command="{Binding ToggleSettingsPaneCommand}" />
        <Button x:Name="CompileButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainCompileButton}" Classes="round" Content="Compile" Command="{Binding CompileCommand}"
                ToolTip.Tip="Compiles the project and outputs the source code if chosen." />
        <Button x:Name="RunButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainRunButton}" Classes="round" Content="Run" Command="{Binding RunCommand}"
                ToolTip.Tip="Compile and run the project. Only enabled for executable projects that output binaries. Requires a static Main method." />
      </StackPanel>

      <TextBlock Grid.Row="1" Classes="header" Text="Classes" Margin="5,10,5,0" />

      <Grid Grid.Row="2" ColumnDefinitions="*,*">
        <Button x:Name="NewClassButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainNewClassButton}" Classes="flat" Content="New Class" Command="{Binding NewClassCommand}" FontSize="16" />
        <Button Grid.Column="1" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainExistingClassButton}" Classes="flat" Content="Existing Class" Command="{Binding AddExistingClassCommand}" FontSize="16" />
      </Grid>

      <ScrollViewer Grid.Row="3" Margin="5,0,5,5" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ClassList" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainClassList}" ItemsSource="{Binding Project.Classes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:ClassGraph">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="flat" Content="{Binding FullName}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainOpenClassButton}"
                        Command="{Binding $parent[ItemsControl].((edmain:MainEditorVM)DataContext).OpenClassCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="1" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainRemoveClassButton}" AutomationProperties.Name="{Binding FullName}" Classes="icon" Width="30" Height="30" CornerRadius="15" ToolTip.Tip="Remove class"
                        Command="{Binding $parent[ItemsControl].((edmain:MainEditorVM)DataContext).RemoveClassCommand}"
                        CommandParameter="{Binding}">
                  <mi:MaterialIcon Kind="Minus" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Project and Settings panes (PAR-02, PAR-07). Not a light-dismiss SplitView: the toolbar
         buttons must stay clickable while a pane is open, as in the WPF flyouts. -->
    <Border IsVisible="{Binding IsPaneOpen}" HorizontalAlignment="Right" Width="300"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="1,0,0,0">
      <Panel Margin="8">
        <!-- Project pane (PAR-02..06) -->
        <StackPanel x:Name="ProjectPane" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainProjectPane}" IsVisible="{Binding IsProjectPaneOpen}" Spacing="4">
          <TextBlock Classes="header" Text="Project" />
          <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainCreateProjectButton}" Classes="flat" Content="Create Project" Command="{Binding CreateProjectCommand}" />
          <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainOpenProjectButton}" Classes="flat" Content="Open Project" Command="{Binding OpenProjectCommand}" />
          <Button Classes="flat" Content="Save Project" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainSaveProjectButton}" Command="{Binding SaveProjectCommand}" />
        </StackPanel>

        <!-- Settings pane (PAR-07) -->
        <StackPanel x:Name="SettingsPane" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainSettingsPane}" IsVisible="{Binding IsSettingsPaneOpen}" Spacing="4">
          <TextBlock Classes="header" Text="Settings" />
          <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="What to output on compilation.">
            <TextBlock Text="Output" VerticalAlignment="Center" Margin="4" />
            <ComboBox AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainOutputChooser}" Grid.Column="1" Margin="4" HorizontalAlignment="Stretch"
                      IsEnabled="{Binding IsProjectOpen}"
                      ItemsSource="{Binding CompilationOutputs}"
                      SelectedItem="{Binding CompilationOutput}" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="Type of binary to output.">
            <TextBlock Text="Binary type" VerticalAlignment="Center" Margin="4" />
            <ComboBox AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainBinaryTypeChooser}" Grid.Column="1" Margin="4" HorizontalAlignment="Stretch"
                      IsEnabled="{Binding IsProjectOpen}"
                      ItemsSource="{Binding BinaryTypes}"
                      SelectedItem="{Binding OutputBinaryType}" />
          </Grid>
        </StackPanel>
      </Panel>
    </Border>

    <!-- Progress overlay while a project loads (PAR-04) -->
    <Border x:Name="BusyOverlay" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.MainBusyOverlay}" IsVisible="{Binding IsBusy}" Background="#AA000000">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="40" Spacing="8">
        <TextBlock Text="{Binding BusyTitle}" FontSize="24" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding BusyMessage}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar IsIndeterminate="True" />
      </StackPanel>
    </Border>
  </Panel>
</Window>
