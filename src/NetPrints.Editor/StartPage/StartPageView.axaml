<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
             xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:sp="clr-namespace:NetPrints.Editor.StartPage"
             x:Class="NetPrints.Editor.StartPage.StartPageView"
             x:DataType="sp:StartPageViewModel"
             AutomationProperties.AutomationId="{x:Static ed:AutomationIds.StartPageRoot}">
  <!-- The start page document, laid out like a start window: Open recent beside Get started from 960 DIP, stacked below, then What's new. -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="sp:RecentProjectsTileViewModel" x:DataType="sp:RecentProjectsTileViewModel">
      <sp:RecentProjectsTileView />
    </DataTemplate>
    <DataTemplate DataType="sp:SamplesTileViewModel" x:DataType="sp:SamplesTileViewModel">
      <sp:SamplesTileView />
    </DataTemplate>
    <DataTemplate DataType="sp:LearnTileViewModel" x:DataType="sp:LearnTileViewModel">
      <sp:LearnTileView />
    </DataTemplate>
    <DataTemplate DataType="sp:WhatsNewTileViewModel" x:DataType="sp:WhatsNewTileViewModel">
      <sp:WhatsNewTileView />
    </DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.Resources>
    <x:Double x:Key="StartPageLogoSize">42</x:Double>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Grid#Columns > StackPanel">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="Grid#Columns > StackPanel#GetStartedSection">
      <Setter Property="Grid.Row" Value="0" />
    </Style>
    <Style Selector="Grid#Columns > StackPanel#RecentSection">
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="Button.card">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.card:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="RenderTransform" Value="scale(1.02)" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="Button.card:pressed">
      <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <!-- Replaced literal color box shadow with empty space or standard resource if it existed -->
    </Style>
    <Style Selector="Border.card-icon">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.card:pointerover Border.card-icon">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="Button.card:pointerover Border.card-icon > icons|IconPresenter">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundChromeWhiteBrush}" />
    </Style>
    <Style Selector="Border.card-icon > icons|IconPresenter">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="Button.section-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Two columns from 960 DIP: Open recent left (2*), Get started right (3*), on the same row. -->
    <ContainerQuery Name="start" Query="min-width:960">
      <Style Selector="Grid#Columns > StackPanel#RecentSection">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
      </Style>
      <Style Selector="Grid#Columns > StackPanel#GetStartedSection">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Container.Name="start" Container.Sizing="Width">
      <StackPanel Margin="32,24" Spacing="24" MaxWidth="1200" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.StartPageContent}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Image Source="avares://NetPrints.Editor/Assets/NetPrintsLogo.png" Width="{DynamicResource StartPageLogoSize}" Height="{DynamicResource StartPageLogoSize}"
                   RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Classes="title" Text="NetPrints" VerticalAlignment="Center" />
            <TextBlock Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,8" Text="{Binding Version}"
                       AutomationProperties.AutomationId="{x:Static ed:AutomationIds.StartPageVersion}" />
          </StackPanel>
          <CheckBox Grid.Column="1" VerticalAlignment="Bottom" Content="Reopen the last project when NetPrints starts" IsChecked="{Binding ReopenLastProject}"
                    AutomationProperties.AutomationId="{x:Static ed:AutomationIds.StartPageReopenLast}" />
        </Grid>
        <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="{x:Static ed:AutomationIds.StartPageError}" />
        <Grid x:Name="Columns" ColumnDefinitions="2*,3*" RowDefinitions="Auto,Auto" ColumnSpacing="40" RowSpacing="24">
          <StackPanel x:Name="GetStartedSection" Spacing="12" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.StartPageGetStarted}">
            <TextBlock Classes="section" Text="Get started" />
            <ItemsControl ItemsSource="{Binding GetStarted}" ClipToBounds="False">
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="sp:NewProjectTileViewModel" x:DataType="sp:NewProjectTileViewModel">
                  <Button Classes="card" Command="{Binding NewCommand}" AutomationProperties.Name="New project"
                          AutomationProperties.AutomationId="{x:Static ed:AutomationIds.StartPageNewButton}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                      <Border Classes="card-icon"><icons:IconPresenter IconId="{x:Static icons:IconIds.CardNewProject}" /></Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="New project…" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Create a console app or a class library from a template." />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
                <DataTemplate DataType="sp:OpenProjectTileViewModel" x:DataType="sp:OpenProjectTileViewModel">
                  <Button Classes="card" Command="{Binding OpenCommand}" AutomationProperties.Name="Open folder or project"
                          AutomationProperties.AutomationId="{x:Static ed:AutomationIds.StartPageOpenButton}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                      <Border Classes="card-icon"><icons:IconPresenter IconId="{x:Static icons:IconIds.CardOpenProject}" /></Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Open folder or project…" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Open a project folder or a .csproj file from disk." />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.DataTemplates>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ContentControl Content="{Binding Samples}" />
            <ContentControl Content="{Binding Learn}" />
          </StackPanel>
          <StackPanel x:Name="RecentSection">
            <ContentControl Content="{Binding Recent}" />
          </StackPanel>
        </Grid>
        <StackPanel Spacing="8" IsVisible="{Binding WhatsNew, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Button Classes="section-toggle" Command="{Binding ToggleWhatsNewCommand}" AutomationProperties.Name="What's new"
                  AutomationProperties.AutomationId="{x:Static ed:AutomationIds.StartPageWhatsNewToggle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:IconPresenter IconId="{x:Static icons:IconIds.ChevronRight}" IsVisible="{Binding !IsWhatsNewExpanded}" />
              <icons:IconPresenter IconId="{x:Static icons:IconIds.ChevronDown}" IsVisible="{Binding IsWhatsNewExpanded}" />
              <TextBlock Classes="section" Text="What's new" />
            </StackPanel>
          </Button>
          <ItemsControl ItemsSource="{Binding WhatsNewTiles}" IsVisible="{Binding IsWhatsNewExpanded}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Others}" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
