<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:NetPrints.Editor.Controls"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        xmlns:edreferences="clr-namespace:NetPrints.Editor.References"
        xmlns:icons="clr-namespace:NetPrints.Editor.Icons"
        x:Class="NetPrints.Editor.References.ReferencesDialog"
        x:DataType="edreferences:ReferenceListViewModel"
        Title="References"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        SizeToContent="Height" Width="{StaticResource Dialog.MaxWidth}"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ReferencesDialog}">
  <ctl:DialogShell Title="{Binding $parent[Window].Title}" IconId="{x:Static icons:IconIds.References}">
    <ctl:DialogShell.Actions>
      <!-- Closes the dialog with no result (D11, ADR-0007 batch X2b); Esc runs it. -->
      <Button AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ReferencesCloseButton}" Content="Close" Classes="dialogAction" IsCancel="True">
        <Interaction.Behaviors>
          <ButtonClickEventTriggerBehavior>
            <CloseWindowAction />
          </ButtonClickEventTriggerBehavior>
        </Interaction.Behaviors>
      </Button>
    </ctl:DialogShell.Actions>
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,*">
      <Button Classes="flat" Content="Assembly" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ReferencesAddAssemblyButton}" Command="{Binding AddAssemblyCommand}"
              ToolTip.Tip="Add an assembly reference" />
      <Button Grid.Column="1" Classes="flat" Content="Source code" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ReferencesAddSourceButton}" Command="{Binding AddSourceDirectoryCommand}"
              ToolTip.Tip="Add a source code directory reference which searches for .cs files" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="{StaticResource Dialog.ListMaxHeight}">
      <ItemsControl x:Name="ReferenceList" ItemsSource="{Binding References}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="edreferences:DeclaredReferenceViewModel">
            <Grid ColumnDefinitions="*,150,Auto" Margin="2" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ReferenceRow}" AutomationProperties.Name="{Binding DisplayText}">
              <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         FontSize="{StaticResource Font.Body}" ToolTip.Tip="{Binding DisplayText}" />
              <!-- OneWay (R2-10, D10): toggling invokes SetIncludedCommand instead of a property setter
                   kicking off an untracked async edit. The parameter is the switch's own clicked state
                   (F-06), not the row's last-applied state, so a stale switch cannot invert the next click. -->
              <ToggleSwitch x:Name="IncludeToggle" Grid.Column="1" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ReferenceInclude}" IsChecked="{Binding IncludeInCompilation, Mode=OneWay}"
                            IsEnabled="{Binding ShowIncludeInCompilation}"
                            OnContent="Include" OffContent="Exclude"
                            ToolTip.Tip="Whether to include the reference as a source in the compilation process."
                            ToolTip.ShowOnDisabled="True" VerticalAlignment="Center">
                <Interaction.Behaviors>
                  <EventTriggerBehavior EventName="IsCheckedChanged">
                    <InvokeCommandAction Command="{Binding SetIncludedCommand}"
                                          CommandParameter="{Binding #IncludeToggle.IsChecked}" />
                  </EventTriggerBehavior>
                </Interaction.Behaviors>
              </ToggleSwitch>
              <Button Grid.Column="2" Classes="icon" Width="32" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ReferenceRemove}" Height="32" CornerRadius="16"
                      ToolTip.Tip="Remove this reference" AutomationProperties.Name="Remove this reference"
                      Command="{Binding $parent[ItemsControl].((edreferences:ReferenceListViewModel)DataContext).RemoveCommand}"
                      CommandParameter="{Binding}">
                <icons:IconPresenter IconId="{x:Static icons:IconIds.Remove}" />
              </Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>
  </ctl:DialogShell>
</Window>
