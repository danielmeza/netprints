<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:edvariables="clr-namespace:NetPrints.Editor.Variables"
             x:Class="NetPrints.Editor.Inspectors.LocalVariableInspectorView"
             x:DataType="edvariables:LocalVariableViewModel">
  <!-- Local variable inspector: the name and the type of a local of the opened method. -->
  <Grid AutomationProperties.AutomationId="{x:Static ed:AutomationIds.LocalVariableInspector}" RowDefinitions="Auto,Auto,Auto,Auto" Classes="propertyGrid inspectorRoot">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{DynamicResource Inspector.LabelColumnWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.ColumnSpan="2" Classes="header" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="NameLabel" Grid.Row="1" Classes="inspectorLabel" Text="Name" />
    <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.LocalVariableInspectorName}"
             AutomationProperties.LabeledBy="{Binding #NameLabel}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}">
      <Interaction.Behaviors>
        <LoseFocusOnEnterBehavior />
      </Interaction.Behaviors>
    </TextBox>
    <TextBlock Grid.Row="2" Grid.Column="1" Classes="fieldError" Text="{Binding Error}" IsVisible="{Binding HasError}"
               AutomationProperties.AutomationId="{x:Static ed:AutomationIds.LocalVariableInspectorError}" />
    <TextBlock x:Name="TypeLabel" Grid.Row="3" Classes="inspectorLabel" Text="Type" />
    <Button Grid.Row="3" Grid.Column="1" Classes="flat" HorizontalAlignment="Left" Content="{Binding TypeName}" ToolTip.Tip="Change type" Command="{Binding RetypeCommand}"
            AutomationProperties.AutomationId="{x:Static ed:AutomationIds.LocalVariableInspectorType}" AutomationProperties.LabeledBy="{Binding #TypeLabel}" />
  </Grid>
</UserControl>
