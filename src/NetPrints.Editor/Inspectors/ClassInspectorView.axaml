<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:edclasseditor="clr-namespace:NetPrints.Editor.ClassEditor"
             x:Class="NetPrints.Editor.Inspectors.ClassInspectorView"
             x:DataType="edclasseditor:ClassEditorVM">
  <!-- Class inspector (PAR-34) -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*" Margin="4">
    <TextBlock Grid.ColumnSpan="2" Classes="header" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    <TextBlock Grid.Row="1" Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
    <TextBox x:Name="NameBox" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassInspectorName}" Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="2" Text="Namespace" VerticalAlignment="Center" Margin="0,0,8,0" />
    <TextBox x:Name="NamespaceBox" Grid.Row="2" Grid.Column="1" Text="{Binding Namespace, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="3" Text="Visibility" VerticalAlignment="Center" Margin="0,0,8,0" />
    <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding PossibleVisibilities}" SelectedItem="{Binding Visibility}" />
    <TextBlock Grid.Row="4" Text="Sealed" VerticalAlignment="Center" Margin="0,0,8,0" />
    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding IsSealed}" />
    <TextBlock Grid.Row="5" Text="Abstract" VerticalAlignment="Center" Margin="0,0,8,0" />
    <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding IsAbstract}" />
    <TextBlock Grid.Row="6" Text="Static" VerticalAlignment="Center" Margin="0,0,8,0" />
    <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding IsStatic}" />
    <TextBlock Grid.Row="7" Text="Partial" VerticalAlignment="Center" Margin="0,0,8,0" />
    <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding IsPartial}" />
    <!-- Generated C# preview, refreshed about every second (WPF parity: NoWrap with a horizontal
         scrollbar rather than wrapping, so indentation and statements are never broken up). -->
    <TextBox x:Name="GeneratedCodeBox" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ClassInspectorGeneratedCode}" Grid.Row="8" Grid.ColumnSpan="2" Margin="0,4,0,0" Text="{Binding GeneratedCode}" IsReadOnly="True"
             TextWrapping="NoWrap" AcceptsReturn="True" FontFamily="monospace" VerticalContentAlignment="Top"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </Grid>
</UserControl>
