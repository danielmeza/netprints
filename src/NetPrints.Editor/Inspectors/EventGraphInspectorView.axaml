<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:edevents="clr-namespace:NetPrints.Editor.Events"
             x:Class="NetPrints.Editor.Inspectors.EventGraphInspectorView"
             x:DataType="edevents:EventGraphViewModel">
  <!-- Event graph inspector (US8, FR-070): the name, renamed as one undo step; a duplicate is refused with a message. -->
  <Grid AutomationProperties.AutomationId="{x:Static ed:AutomationIds.EventGraphInspector}" RowDefinitions="Auto,Auto,Auto,Auto" Classes="propertyGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource Inspector.LabelColumnWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.ColumnSpan="2" Classes="header" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="NameLabel" Grid.Row="1" Classes="inspectorLabel" Text="Name" />
    <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.EventGraphInspectorName}"
             AutomationProperties.LabeledBy="{Binding #NameLabel}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}">
      <Interaction.Behaviors>
        <LoseFocusOnEnterBehavior />
      </Interaction.Behaviors>
    </TextBox>
    <TextBlock Grid.Row="2" Grid.Column="1" Classes="fieldError" Text="{Binding Error}" IsVisible="{Binding HasError}"
               AutomationProperties.AutomationId="{x:Static ed:AutomationIds.EventGraphInspectorError}" />
    <TextBlock Grid.Row="3" Classes="inspectorLabel" Text="Entries" />
    <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Entries}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="edevents:EventEntryItemViewModel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="flat" Content="Select" Command="{Binding SelectCommand}"
                    AutomationProperties.AutomationId="{x:Static ed:AutomationIds.EventGraphInspectorSelectEntry}"
                    AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
