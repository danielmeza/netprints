<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:spike="clr-namespace:NetPrints.Editor.Shell.Docking.Spike"
             xmlns:ederrorlist="clr-namespace:NetPrints.Editor.ErrorList"
             x:Class="NetPrints.Editor.Shell.Docking.Spike.DockSpikeView"
             x:DataType="spike:DockSpikeViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4">
      <Button Content="Float" Command="{Binding FloatDocumentCommand}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.DockSpikeFloat}" />
      <Button Content="Dock" Command="{Binding DockDocumentCommand}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.DockSpikeDock}" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Height="16" Background="{DynamicResource DockSpikeSwatch}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.DockSpikeSwatch}" />
    <DockControl Layout="{Binding Layout}" InitializeFactory="True" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.DockSpikeHost}" />
  </DockPanel>
</UserControl>
