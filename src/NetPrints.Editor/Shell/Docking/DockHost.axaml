<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docking="clr-namespace:NetPrints.Editor.Shell.Docking"
             x:Class="NetPrints.Editor.Shell.Docking.DockHost"
             x:DataType="docking:DockShellAdapter">
  <!-- InitializeLayout stays off: attaching such a control closes the layout's floating windows (ADR-0018 check 2). -->
  <DockControl Layout="{Binding Layout}" InitializeFactory="True" />
</UserControl>
