<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dockfluent="clr-namespace:Dock.Avalonia.Themes.Fluent;assembly=Dock.Avalonia.Themes.Fluent">
  <dockfluent:DockFluentTheme />
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Dock's own surface tokens come from the editor's tokens (ADR-0018 check 5): Light and Dark through DynamicResource. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="Dock.SurfaceColor">#FF333333</Color>
          <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="{DynamicResource Dock.SurfaceColor}" />
          <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="{DynamicResource Dock.SurfaceColor}" />
          <SolidColorBrush x:Key="DockSpikeSwatch" Color="{DynamicResource Dock.SurfaceColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="Dock.SurfaceColor">#FFE6E6E6</Color>
          <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="{DynamicResource Dock.SurfaceColor}" />
          <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="{DynamicResource Dock.SurfaceColor}" />
          <SolidColorBrush x:Key="DockSpikeSwatch" Color="{DynamicResource Dock.SurfaceColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
