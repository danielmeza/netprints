<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dockfluent="clr-namespace:Dock.Avalonia.Themes.Fluent;assembly=Dock.Avalonia.Themes.Fluent">
  <dockfluent:DockFluentTheme />
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Dock's surface tokens are the editor palette's chrome color, so Light and Dark follow it. -->
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="{DynamicResource SystemChromeMediumColor}" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="{DynamicResource SystemChromeMediumColor}" />
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
