<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:dockfluent="clr-namespace:Dock.Avalonia.Themes.Fluent;assembly=Dock.Avalonia.Themes.Fluent">
  <dockfluent:DockFluentTheme />
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NetPrints.Editor/Icons/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Dock's surface tokens: make the header blend smoothly with the editor background. -->
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="{DynamicResource SystemAltMediumHighColor}" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="{DynamicResource Canvas.Background}" />
      <SolidColorBrush x:Key="DockTabStripBorderBrush" Color="{DynamicResource Tab.StripBorder}" />
      <x:Double x:Key="DockDocumentTabStripSeparatorSize">1</x:Double>
      <!-- Glyph box and button size of the chrome; Dock sizes each glyph by its own geometry, so the box is fixed here and every geometry below shares one grid. -->
      <sys:Double x:Key="DockChromeIconSize">16</sys:Double>
      <sys:Double x:Key="DockChromeButtonSize">24</sys:Double>
      <sys:Double x:Key="DockChromeButtonWidth">24</sys:Double>
      <sys:Double x:Key="DockChromeButtonHeight">24</sys:Double>
      <Thickness x:Key="DockToolChromeMenuIconMargin">0</Thickness>
      <!-- Document tabs: the separator is the strip border (restyled below) and no frame surrounds the document, so the selected tab joins it. -->
      <x:Boolean x:Key="DockDocumentTabStripSeparatorVisible">True</x:Boolean>
      <Thickness x:Key="DockDocumentContentBorderThickness">0</Thickness>
      <!-- Dock's glyph geometry keys, answered by the shared icon set. -->
      <StaticResource x:Key="DockIconMenuGeometry" ResourceKey="Icon.ChevronDown" />
      <StaticResource x:Key="DockIconPinGeometry" ResourceKey="Icon.Pin" />
      <StaticResource x:Key="DockIconPinnedGeometry" ResourceKey="Icon.PinOff" />
      <StaticResource x:Key="DockIconCloseGeometry" ResourceKey="Icon.Close" />
      <StaticResource x:Key="DockToolIconCloseGeometry" ResourceKey="Icon.Close" />
      <StaticResource x:Key="DockIconMaximizeGeometry" ResourceKey="Icon.WindowMaximize" />
      <StaticResource x:Key="DockIconRestoreGeometry" ResourceKey="Icon.WindowRestore" />
      <StaticResource x:Key="DockIconMinimizeGeometry" ResourceKey="Icon.WindowMinimize" />
      <StaticResource x:Key="DockIconAddDocumentGeometry" ResourceKey="Icon.Plus" />
      <StaticResource x:Key="DockIconStatusFloatGeometry" ResourceKey="Icon.OpenInNew" />
      <StaticResource x:Key="DockIconStatusDockGeometry" ResourceKey="Icon.DockWindow" />
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="ToolChromeControl /template/ Button">
    <Setter Property="MinWidth" Value="{DynamicResource DockChromeButtonSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource DockChromeButtonSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToolChromeControl /template/ Button Viewbox">
    <Setter Property="Width" Value="{DynamicResource DockChromeIconSize}" />
    <Setter Property="Height" Value="{DynamicResource DockChromeIconSize}" />
  </Style>
  <Style Selector="DocumentTabStripItem Button">
    <Setter Property="Width" Value="{DynamicResource Tab.CloseButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource Tab.CloseButtonSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource Tab.CloseButtonSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource Tab.CloseButtonSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Document tabs (FR-087): the shared focus ring, and the state tokens on the tabs that are not selected. -->
  <Style Selector="DocumentTabStripItem">
    <Setter Property="FocusAdorner" Value="{DynamicResource NetPrints.FocusAdorner}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tab}" />
    <Setter Property="MinHeight" Value="{DynamicResource Tab.Height}" />
  </Style>
  <!-- The selected tab is the document's surface with an accent edge on top; no separator or border sits between it and the document. -->
  <Style Selector="DocumentTabStripItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="DocumentTabStripItem /template/ Border#PART_TabBody">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tab}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource Motion.Fast}" Easing="{DynamicResource Motion.Easing}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="DocumentTabStripItem:not(:selected) /template/ Border#PART_TabBody">
    <Setter Property="Opacity" Value="{DynamicResource Tab.InactiveOpacity}" />
    <Setter Property="Margin" Value="{DynamicResource Tab.InactiveInset}" />
    <Setter Property="Padding" Value="{DynamicResource Tab.BodyPadding}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Tab.SelectedBorderThickness}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="DocumentTabStripItem:selected /template/ Border#PART_TabBody">
    <Setter Property="Background" Value="{DynamicResource DockSurfaceEditorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockTabStripBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Tab.SelectedBorderThickness}" />
    <Setter Property="Padding" Value="{DynamicResource Tab.SelectedBodyPadding}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="DocumentTabStripItem:selected /template/ Border#PART_TabGutter">
    <Setter Property="BorderBrush" Value="{DynamicResource Tab.SelectedAccent}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Tab.AccentThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tab}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- The strip border runs under the whole strip; the selected tab, one pixel taller than the others, covers it, so the tab opens into the document. -->
  <Style Selector="DocumentTabStrip">
    <Setter Property="ZIndex" Value="1" />
    <Setter Property="Margin" Value="{DynamicResource Tab.StripOverlap}" />
  </Style>
  <Style Selector="DocumentControl /template/ Panel#PART_DocumentSeperator">
    <Setter Property="Background" Value="{DynamicResource DockTabStripBorderBrush}" />
  </Style>
  <Style Selector="DocumentControl:active /template/ Panel#PART_DocumentSeperator">
    <Setter Property="Background" Value="{DynamicResource DockTabStripBorderBrush}" />
  </Style>
  <Style Selector="ItemsControl.breadcrumbBar">
    <Setter Property="Background" Value="{DynamicResource DockSurfaceEditorBrush}" />
  </Style>
  <Style Selector="DocumentTabStripItem:pointerover:not(:selected) /template/ Border#PART_TabBody">
    <Setter Property="Background" Value="{DynamicResource State.Hover}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DocumentTabStripItem:pressed /template/ Border#PART_TabBody">
    <Setter Property="Background" Value="{DynamicResource State.Pressed}" />
  </Style>
  <Style Selector="DocumentTabStripItem Button Path">
    <Setter Property="Width" Value="{DynamicResource DockChromeIconSize}" />
    <Setter Property="Height" Value="{DynamicResource DockChromeIconSize}" />
  </Style>
</Styles>
