<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetPrints.Generator</AssemblyName>
    <!-- Ahead of using it (T044+): keep the logging-usage rules an error once logging is added here. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1848;CA2254</WarningsAsErrors>
    <!-- Always invoked as "dotnet exec NetPrints.Generator.dll ..." (NetPrints.Sdk.targets) or as a
         plain library reference from NetPrints.Editor (ClassEditorVM.RenderFile, see that project's
         ReferenceOutputAssembly="false" + Reference pair: release contract §5); never run as its own
         native executable, so no apphost is needed. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetPrints.Core\NetPrints.Core.csproj" />
    <ProjectReference Include="..\NetPrints.Extensibility\NetPrints.Extensibility.csproj" />
    <ProjectReference Include="..\NetPrints.Serialization\NetPrints.Serialization.csproj" />
  </ItemGroup>
</Project>
