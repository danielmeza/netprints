<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetPrints.Generator</AssemblyName>
    <!-- Always invoked as "dotnet exec NetPrints.Generator.dll ..." (NetPrints.Sdk.targets); never run
         as its own native executable, so no apphost is needed. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- Thin host over the translation logic in NetPrints.Generation, a normal library also referenced
         directly by NetPrints.Editor (ADR-0009; supersedes the ADR-0005 HintPath workaround). -->
    <ProjectReference Include="..\NetPrints.Generation\NetPrints.Generation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- GenerateRequestFileExitCodeTests (R1-20) calls Program.Main directly with a request path. -->
    <InternalsVisibleTo Include="NetPrints.Core.Tests" />
  </ItemGroup>
</Project>
