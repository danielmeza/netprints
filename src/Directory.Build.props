<Project>
  <Import Project="../Directory.Build.props" />

  <!-- Owner decision 2026-09-25 (specs/003-core-refactor/contracts/release-and-docs.md §"XML
       documentation"): every public API in src/ has an XML doc comment. Generating the doc file
       makes the compiler emit CS1591/CS1572/CS1573/CS1574 for anything missing or malformed;
       the root .editorconfig promotes those to errors under [src/**.cs] so a missing doc fails
       the build regardless of a project's TreatWarningsAsErrors setting. tests/ is not affected
       (tests/Directory.Build.props does not import this file). -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ADR-0003 follow-up: Microsoft.CodeAnalysis.BannedApiAnalyzers (RS0030), src/ only (see the
       root Directory.Build.props for the other analyzer packages, which also cover tests/). The
       analyzer only reads additional files literally named "BannedSymbols.*.txt". BannedSymbols.txt
       bans sync-over-async and DateTime.Now/Thread.Sleep everywhere in src/; BannedSymbols.Console.txt
       additionally bans System.Console in library projects — not Cli, Desktop, Editor or Generator,
       each of which is its own console/UI entry point (OutputType Exe) and legitimately writes to
       Console/the UI. $(OutputType) isn't set yet when this file is evaluated (each Exe project sets
       it in its own .csproj, imported after this one), so the four are named explicitly rather than
       conditioned on it. Skipped on the legacy VSIX project, same as the other analyzer-only
       packages above. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'NetPrintsVSIX'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'NetPrintsVSIX' And '$(MSBuildProjectName)' != 'NetPrints.Cli' And '$(MSBuildProjectName)' != 'NetPrints.Desktop' And '$(MSBuildProjectName)' != 'NetPrints.Editor' And '$(MSBuildProjectName)' != 'NetPrints.Generator'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Console.txt" />
  </ItemGroup>
</Project>
