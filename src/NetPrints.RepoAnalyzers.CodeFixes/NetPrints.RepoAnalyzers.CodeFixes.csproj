<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Description>Code fixes for the repository-internal analyzers (NPS), run by dotnet format analyzers; never packed.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Roslyn\**\*.cs" Link="Shared\Roslyn\%(Filename)%(Extension)" />
    <Compile Include="..\NetPrints.RepoAnalyzers\Style\NpsDiagnosticCodes.cs" Link="Style\NpsDiagnosticCodes.cs" />
  </ItemGroup>
</Project>
