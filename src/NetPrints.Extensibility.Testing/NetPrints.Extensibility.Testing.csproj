<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NetPrintsTrackPublicApi>true</NetPrintsTrackPublicApi>
    <AssemblyName>NetPrints.Extensibility.Testing</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>The NetPrints extension test kit: a harness that loads real and folder-based extensions, a declarative extension test and the conformance suite that checks an extension against the rules of the extension API. NetPrints continues the original NetPrints by Robin Kahlow (https://github.com/RobinKa/netprints).</Description>
    <WarningsAsErrors>$(WarningsAsErrors);CA1848;CA2254</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <NetPrintsExperimentalOptIn Include="NPXE0001" />
    <NetPrintsExperimentalOptIn Include="NPXE0002" />
    <NetPrintsExperimentalOptIn Include="NPXE0003" />
    <NetPrintsExperimentalOptIn Include="NPXE0004" />
    <NetPrintsExperimentalOptIn Include="NPXE0005" />
    <NetPrintsExperimentalOptIn Include="NPXE0006" />
    <NetPrintsExperimentalOptIn Include="NPXE0007" />
    <NetPrintsExperimentalOptIn Include="NPXE0008" />
    <NetPrintsExperimentalOptIn Include="NPXE0009" />
    <NetPrintsExperimentalOptIn Include="NPXE0011" />
    <NetPrintsExperimentalOptIn Include="NPXE0012" />
    <NetPrintsExperimentalOptIn Include="NPXE0013" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetPrints.Extensibility.Abstractions\NetPrints.Extensibility.Abstractions.csproj" />
    <ProjectReference Include="..\NetPrints.Extensibility\NetPrints.Extensibility.csproj" />
    <ProjectReference Include="..\NetPrints.Core\NetPrints.Core.csproj" />
    <ProjectReference Include="..\NetPrints.Serialization\NetPrints.Serialization.csproj" />
  </ItemGroup>
</Project>
