<!-- NetPrints.Sdk: the NetPrintsGenerate target (project-system.md §2). Imported by the package's own
     build/NetPrints.Sdk.targets (published) and, in-repo, by samples/Directory.Build.targets (§2.1). -->
<Project>
  <ItemGroup Condition="'$(EnableDefaultNetPrintsGraphItems)' == 'true'">
    <NetPrintsGraph Include="**/*.netpc.json" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>
  <ItemGroup>
    <NetPrintsGraph Update="@(NetPrintsGraph)" GeneratedFile="%(RootDir)%(Directory)%(Filename).g.cs" DependentUpon="%(Filename)%(Extension)" />
    <Compile Remove="**/*.netpc.g.cs" />
    <Compile Include="@(NetPrintsGraph->'%(GeneratedFile)')" />
    <UpToDateCheckInput Include="@(NetPrintsGraph)" />
  </ItemGroup>

  <PropertyGroup>
    <_NetPrintsRequest>$(IntermediateOutputPath)netprints.generate.rsp</_NetPrintsRequest>
  </PropertyGroup>

  <!-- The C# target (ADR-0038): the language version of every target framework, so that each inner build of a multi-targeted
       project writes the same request and the generator resolves the same version as the editor and `netprints regen`. -->
  <Target Name="_NetPrintsFrameworkInfo" Returns="@(_NetPrintsFrameworkInfoItem)">
    <ItemGroup>
      <_NetPrintsFrameworkInfoItem Include="$(TargetFramework)" LangVersion="$(LangVersion)" MaxSupportedLangVersion="$(MaxSupportedLangVersion)" />
    </ItemGroup>
  </Target>

  <Target Name="_NetPrintsCollectFrameworks">
    <ItemGroup>
      <_NetPrintsFrameworkName Include="$(TargetFrameworks)" Condition="'$(TargetFrameworks)' != ''" />
      <_NetPrintsFrameworkName Include="$(TargetFramework)" Condition="'$(TargetFrameworks)' == ''" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_NetPrintsFrameworkInfo" Properties="TargetFramework=%(_NetPrintsFrameworkName.Identity)">
      <Output TaskParameter="TargetOutputs" ItemName="_NetPrintsFramework" />
    </MSBuild>
  </Target>

  <!-- Written by its own target, ahead of NetPrintsGenerate, so the request file — and the extension
       assemblies' actual, glob-expanded paths (R1-12: implicit metadata batching on
       %(NetPrintsExtension.FullPath), only available inside a target, makes each Include a plain,
       globbable string — unlike an '@(NetPrintsExtension->'%(FullPath)/**/*.dll')' transform, which
       Inputs treats as one literal, non-existent path) — can themselves be Inputs of that target
       (WriteOnlyWhenDifferent so RootNamespace/NetPrintsProfile changes from Directory.Build.props
       invalidate it even though no graph or extension file changed). -->
  <Target Name="_NetPrintsWriteRequest" Condition="'@(NetPrintsGraph)' != ''" DependsOnTargets="_NetPrintsCollectFrameworks">
    <ItemGroup>
      <_NetPrintsExtensionAssembly Include="%(NetPrintsExtension.FullPath)/**/*.dll" Condition="'@(NetPrintsExtension)' != ''" />
      <_NetPrintsRequestLine Include="project=$(MSBuildProjectFullPath)" />
      <_NetPrintsRequestLine Include="@(_NetPrintsFramework->'framework=%(Identity)|%(LangVersion)|%(MaxSupportedLangVersion)')" />
      <_NetPrintsRequestLine Include="rootNamespace=$(RootNamespace)" />
      <_NetPrintsRequestLine Include="profile=$(NetPrintsProfile)" />
      <_NetPrintsRequestLine Include="@(NetPrintsExtension->'extension=%(FullPath)')" />
      <_NetPrintsRequestLine Include="@(NetPrintsGraph->'graph=%(FullPath)|%(GeneratedFile)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_NetPrintsRequest)" Lines="@(_NetPrintsRequestLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- _NetPrintsSkipGenerate is internal: only the CLI's project system sets it as a global property to prevent
       regeneration while loading, keeping the generated files as they are. It is not a user setting. -->
  <Target Name="_NetPrintsReportSkippedGenerate"
          BeforeTargets="CoreCompile"
          Condition="'@(NetPrintsGraph)' != '' and '$(_NetPrintsSkipGenerate)' == 'true'">
    <Message Importance="low" Text="NetPrintsGenerate skipped: _NetPrintsSkipGenerate is set, the generated files are used as they are." />
  </Target>

  <Target Name="NetPrintsGenerate"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_NetPrintsWriteRequest"
          Condition="'@(NetPrintsGraph)' != '' and '$(_NetPrintsSkipGenerate)' != 'true'"
          Inputs="@(NetPrintsGraph);$(NetPrintsGeneratorPath);$(MSBuildProjectFullPath);$(_NetPrintsRequest);@(NetPrintsExtension->'%(FullPath)/netprints-extension.json');@(_NetPrintsExtensionAssembly)"
          Outputs="@(NetPrintsGraph->'%(GeneratedFile)')">
    <PropertyGroup>
      <_NetPrintsHost>$(DOTNET_HOST_PATH)</_NetPrintsHost>
      <_NetPrintsHost Condition="'$(_NetPrintsHost)' == '' and '$(NetCoreRoot)' != ''">$(NetCoreRoot)dotnet$(_NetPrintsExeExtension)</_NetPrintsHost>
      <_NetPrintsHost Condition="'$(_NetPrintsHost)' == ''">dotnet</_NetPrintsHost>
    </PropertyGroup>
    <Exec Command="&quot;$(_NetPrintsHost)&quot; exec &quot;$(NetPrintsGeneratorPath)&quot; generate &quot;$(_NetPrintsRequest)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Touch Files="@(NetPrintsGraph->'%(GeneratedFile)')" />
  </Target>
</Project>
