<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NetPrintsTrackPublicApi>true</NetPrintsTrackPublicApi>
    <AssemblyName>NetPrints.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>The NetPrints graph model and C# translator: classes, methods and node graphs that NetPrints turns into readable C#. NetPrints continues the original NetPrints by Robin Kahlow (https://github.com/RobinKa/netprints).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <!-- The document mapper sets Node.Id and member ids (internal set) from a loaded document. -->
    <InternalsVisibleTo Include="NetPrints.Serialization" />
    <InternalsVisibleTo Include="NetPrints.Core.Tests" />
  </ItemGroup>
</Project>
