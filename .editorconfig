root = true

# Line endings and file encoding are governed by .gitattributes (mixed CRLF/LF, BOM/no-BOM
# across the legacy Core/Reflection/VSIX code vs. the newer Editor/Desktop/Cli/test code); this
# file intentionally does not set end_of_line or charset so `dotnet format` leaves them alone.
[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,axaml,xaml}]
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Legacy VSIX (.NET Framework, kept for reference, not built) — no formatting opinions.
[legacy/NetPrintsVSIX/**]
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.{png,ico,zip}]
insert_final_newline = unset
trim_trailing_whitespace = unset

# ---------------------------------------------------------------------------
# C# formatting and style. Severities are left at the analyzer defaults
# (mostly "silent"/"suggestion") to match the pre-existing build: CSharpRuleSet.ruleset
# only ever set one Roslynator rule (RCS1001) for which no analyzer package was referenced,
# so no analyzer diagnostic was actually active before this file. TreatWarningsAsErrors is set
# once, repo-wide, in the root Directory.Build.props: every project, including NetPrints.Core
# and NetPrints.Reflection, fails its build on any diagnostic whose severity is `warning` or above.
# ---------------------------------------------------------------------------
[*.cs]

# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# this. preferences
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Language keywords instead of framework type names for type references
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Modifier preferences
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion

# Expression-level preferences
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

# var preferences (mixed usage in this codebase; suggestion only, never enforced)
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent

# Namespaces: file-scoped in code added since P0 (NetPrints.Editor, NetPrints.Desktop and the
# test projects); NetPrints.Core and NetPrints.Reflection keep their original block-scoped form
# until P1 touches those files. Suggestion only, so neither style is flagged as an error.
csharp_style_namespace_declarations = file_scoped:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_operators = false:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_indexers = true:silent
csharp_style_expression_bodied_accessors = true:silent

# Pattern matching preferences
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion

# Null-checking preferences
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

# Code block preferences
csharp_prefer_braces = true:silent
csharp_preserve_single_line_blocks = true:silent
csharp_preserve_single_line_statements = false:silent

# Newline settings — Allman style (braces on their own line), the convention already used
# throughout the codebase.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

# Spacing
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after

# Wrapping
csharp_preserve_single_line_statements = false

# ---------------------------------------------------------------------------
# XML documentation (owner decision 2026-09-25, specs/003-core-refactor/contracts/release-and-docs.md
# §"XML documentation"): every public API in src/ has an XML doc comment.
# src/Directory.Build.props sets GenerateDocumentationFile for every src/ project, and these four
# diagnostics are promoted to errors here, independently of TreatWarningsAsErrors (which stays
# project-by-project, per the comment above): a missing or malformed doc comment fails
# `dotnet build` even for the src/ projects not on warnings-as-errors (NetPrints.Reflection,
# NetPrints.Cli). tests/ is untouched: this section is scoped to src/**.cs.
# ---------------------------------------------------------------------------
[src/**.cs]
dotnet_diagnostic.CS1591.severity = error # Missing XML comment for publicly visible type or member
dotnet_diagnostic.CS1572.severity = error # <param> tag names a parameter that does not exist
dotnet_diagnostic.CS1573.severity = error # Parameter has no matching <param> tag in the XML comment
dotnet_diagnostic.CS1574.severity = error # cref/name attribute in an XML comment could not be resolved

# ADR-0003 follow-up: Microsoft.CodeAnalysis.BannedApiAnalyzers (src/BannedSymbols.txt,
# src/ConsoleBannedSymbols.txt), src/ only.
dotnet_diagnostic.RS0030.severity = error # Do not use banned APIs

# ---------------------------------------------------------------------------
# Additional analyzers (ADR-0003): SonarAnalyzer.CSharp, IDisposableAnalyzers and
# Microsoft.VisualStudio.Threading.Analyzers (Directory.Packages.props/Directory.Build.props),
# referenced repo-wide, including tests. AnalysisLevel is bumped to `latest` too
# (Directory.Build.props); AnalysisMode stays at its SDK default rather than `Recommended`: that
# preset bakes per-rule severities into its own shipped global analyzer config, which outranks any
# severity set here, and would need dozens of individual per-rule downgrades to avoid errors — the
# same "unknown amount of pre-existing debt" problem this ADR scopes out, so left as a follow-up
# rather than attempted piecemeal.
#
# Policy: the curated rule set below — SonarAnalyzer.CSharp's S1192/S109/S1854/S1481, every
# IDisposableAnalyzers (IDISP*) rule and every VSTHRD rule except VSTHRD111 — is `error` in
# src/**.cs, not `suggestion`: a real, build-breaking gate, not a hint. S109 (magic numbers) is the
# one exception left running at `suggestion`, and only in the Editor (further down): its remaining
# pre-existing hits there are canvas layout coordinates, too numerous to fix or individually
# suppress in this batch; the count is on record there, pending a dedicated cleanup batch. VSTHRD111
# (ConfigureAwait) is laid out separately further down: `error` by default in src/**.cs, `none` for
# the Editor's UI-bound code and for Desktop, which resume on their UI context deliberately.
#
# These three packages ship hundreds of rules enabled by default at `warning`, and there is no
# single blanket escape hatch for them: `dotnet_analyzer_diagnostic.category-<Category>` cannot
# match Sonar's category names (e.g. "Major Code Smell") because the key syntax does not accept the
# space, so that override silently does nothing (verified empirically); IDISP's own category
# ("IDisposableAnalyzers.Correctness") and VSTHRD's ("Usage"/"Style") would work syntactically, but
# "Usage" and "Style" are shared with plain CA rules this ADR wants left alone. Every rule these
# three packages ship is therefore listed below (or above, for IDISP/VSTHRD) at `suggestion`
# explicitly, so nothing in their default sets fails the build by surprise. Nothing else is
# downgraded here, so every CA diagnostic from AnalysisLevel=latest, and any other analyzer this
# repo references, builds at its own default severity.
#
# A violation the curated rules above catch is fixed for real, unless the line predates P1
# (`git merge-base HEAD origin/master`) and this batch does not otherwise touch it; that narrow case
# is suppressed with a per-file `dotnet_diagnostic.<ruleId>.severity = suggestion` section further down
# (one rule, one file, a trailing-comment reason), and listed in ADR-0003 — never a `#pragma` in the
# .cs file: `git grep -n "pragma warning" -- 'src/*.cs'` stays empty. The "Pre-P1 suppressions" section
# below lists every one.
# ---------------------------------------------------------------------------
[*.cs]
# IDisposableAnalyzers and Microsoft.VisualStudio.Threading.Analyzers, kept at `suggestion`
# repo-wide by rule ID for the same reason as Sonar below (no usable category: IDISP's is
# "IDisposableAnalyzers.Correctness", and VSTHRD's "Usage"/"Style" are shared with CA rules this
# ADR does not want to silence). The rules this ADR curates are set again, at their real severity,
# under src/**.cs below.
dotnet_diagnostic.IDISP001.severity = suggestion
dotnet_diagnostic.IDISP002.severity = suggestion
dotnet_diagnostic.IDISP003.severity = suggestion
dotnet_diagnostic.IDISP004.severity = suggestion
dotnet_diagnostic.IDISP005.severity = suggestion
dotnet_diagnostic.IDISP006.severity = suggestion
dotnet_diagnostic.IDISP007.severity = suggestion
dotnet_diagnostic.IDISP008.severity = suggestion
