[src/**.cs]
# SonarAnalyzer.CSharp: the curated rules this ADR was written for (compilation-and-diagnostics.md
# evidence: duplicated NPT/eventEntry literals), at `error`, including S109 (magic numbers): its
# remaining pre-existing hits are individually suppressed (six in Core, see ADR-0003) or fixed with
# named constants/helpers — there is no per-file or per-project carve-out.
dotnet_diagnostic.S1192.severity = error   # Duplicate string literals
dotnet_diagnostic.S109.severity = error    # Magic numbers
dotnet_diagnostic.S1854.severity = error   # Dead stores
dotnet_diagnostic.S1481.severity = error   # Unused local variables

# IDisposableAnalyzers: every IDISP rule, at `error`.
dotnet_diagnostic.IDISP001.severity = error # Dispose created
dotnet_diagnostic.IDISP002.severity = error # Dispose member
dotnet_diagnostic.IDISP003.severity = error # Dispose previous before re-assigning
dotnet_diagnostic.IDISP004.severity = error # Don't ignore created IDisposable
dotnet_diagnostic.IDISP005.severity = error # Return type should indicate that the value should be disposed
dotnet_diagnostic.IDISP006.severity = error # Implement IDisposable
dotnet_diagnostic.IDISP007.severity = error # Don't dispose injected
dotnet_diagnostic.IDISP008.severity = error # Don't assign member with injected and created disposables
dotnet_diagnostic.IDISP009.severity = error # Add IDisposable interface
dotnet_diagnostic.IDISP010.severity = error # Call base.Dispose(disposing)
dotnet_diagnostic.IDISP011.severity = error # Don't return disposed instance
dotnet_diagnostic.IDISP012.severity = error # Property should not return created disposable
dotnet_diagnostic.IDISP013.severity = error # Await in using
dotnet_diagnostic.IDISP014.severity = error # Use a single instance of HttpClient
dotnet_diagnostic.IDISP015.severity = error # Member should not return created and cached instance
dotnet_diagnostic.IDISP016.severity = error # Don't use disposed instance
dotnet_diagnostic.IDISP017.severity = error # Prefer using
dotnet_diagnostic.IDISP018.severity = error # Call SuppressFinalize
dotnet_diagnostic.IDISP019.severity = error # Call SuppressFinalize
dotnet_diagnostic.IDISP020.severity = error # Call SuppressFinalize(this)
dotnet_diagnostic.IDISP021.severity = error # Call this.Dispose(true)
dotnet_diagnostic.IDISP022.severity = error # Call this.Dispose(false)
dotnet_diagnostic.IDISP023.severity = error # Don't use reference types in finalizer context
dotnet_diagnostic.IDISP024.severity = error # Don't call GC.SuppressFinalize(this) when the type is sealed and has no finalizer
dotnet_diagnostic.IDISP025.severity = error # Class with no virtual dispose method should be sealed
dotnet_diagnostic.IDISP026.severity = error # Class with no virtual DisposeAsyncCore method should be sealed

# Microsoft.VisualStudio.Threading.Analyzers: every VSTHRD rule except VSTHRD111 (laid out
# separately below), at `error`.
dotnet_diagnostic.VSTHRD001.severity = error # Avoid legacy thread switching APIs
dotnet_diagnostic.VSTHRD002.severity = error # Avoid problematic synchronous waits
dotnet_diagnostic.VSTHRD003.severity = error # Avoid awaiting foreign Tasks
dotnet_diagnostic.VSTHRD004.severity = error # Await SwitchToMainThreadAsync
dotnet_diagnostic.VSTHRD010.severity = error # Invoke single-threaded types on Main thread
dotnet_diagnostic.VSTHRD011.severity = error # Use AsyncLazy<T>
dotnet_diagnostic.VSTHRD012.severity = error # Provide JoinableTaskFactory where allowed
dotnet_diagnostic.VSTHRD100.severity = error # Avoid "async void" methods
dotnet_diagnostic.VSTHRD101.severity = error # Avoid unsupported async delegates
dotnet_diagnostic.VSTHRD102.severity = error # Implement internal logic asynchronously
dotnet_diagnostic.VSTHRD103.severity = error # Call the async version of a blocking method
dotnet_diagnostic.VSTHRD104.severity = error # Offer async methods
dotnet_diagnostic.VSTHRD105.severity = error # Avoid method overloads that assume TaskScheduler.Current
dotnet_diagnostic.VSTHRD106.severity = error # Use InvokeAsync to raise async events
dotnet_diagnostic.VSTHRD107.severity = error # Await Task within using expression
dotnet_diagnostic.VSTHRD108.severity = error # Assert thread affinity unconditionally
dotnet_diagnostic.VSTHRD109.severity = error # Switch instead of assert in async methods
dotnet_diagnostic.VSTHRD110.severity = error # Observe result of async calls
dotnet_diagnostic.VSTHRD112.severity = error # Implement System.IAsyncDisposable
dotnet_diagnostic.VSTHRD113.severity = error # Check for System.IAsyncDisposable
dotnet_diagnostic.VSTHRD114.severity = error # Avoid returning a null Task
dotnet_diagnostic.VSTHRD115.severity = error # Avoid creating JoinableTaskContext with null SynchronizationContext
dotnet_diagnostic.VSTHRD200.severity = error # Use "Async" suffix for awaitable method names

# ---------------------------------------------------------------------------
# VSTHRD111 (ConfigureAwait): `error` everywhere in src/ by default — a library with no UI
# synchronization context to resume on should always specify it. The Editor's UI-bound code (view
# models, views, the ModelSync collections views bind to, the composition root that drives them,
# and the Avalonia service adapters that must resume on the UI thread to touch dialogs/clipboard/
# the visual tree) resumes on the UI thread deliberately and turns it off below (finding 11,
# owner-approved 2026-09-27), and so does all of Desktop. Everything else in the Editor (Hosting's
# services, Automation, UndoRedo, and the rest) is not UI-bound and stays at this repo-wide
# `error`, with ConfigureAwait(false) added at each call site that needed it.
# ---------------------------------------------------------------------------
dotnet_diagnostic.VSTHRD111.severity = error # ConfigureAwait(bool)

# ---------------------------------------------------------------------------
# ADR-0003 follow-up batch (2026-09-27): the researched SDK/Sonar rule set below, at the
# severities/scoping the research draft's table 2a set. S1309 is skipped (NoUnlistedSuppressions
# replaces it) and CA2007 is skipped (VSTHRD111 above already enforces ConfigureAwait with this same
# UI/non-UI layering; CA2007 would double-report the same sites). These are SDK (CA) or
# SonarAnalyzer.CSharp (S) rules; tests are not overridden here and build at each rule's own
# AnalysisLevel=latest default severity, same policy as every other CA rule in this file.
# ---------------------------------------------------------------------------
dotnet_diagnostic.CA2016.severity = error   # Forward the CancellationToken parameter
dotnet_diagnostic.CA1068.severity = warning # CancellationToken parameters should come last
dotnet_diagnostic.CA2012.severity = error   # Use ValueTasks correctly
dotnet_diagnostic.CA1861.severity = warning # Avoid constant arrays as arguments
dotnet_diagnostic.CA1510.severity = warning # Use ArgumentNullException throw helper
dotnet_diagnostic.CA1511.severity = warning # Use ArgumentException throw helper
dotnet_diagnostic.CA1512.severity = warning # Use ArgumentOutOfRangeException throw helper
dotnet_diagnostic.CA1513.severity = warning # Use ObjectDisposedException throw helper
dotnet_diagnostic.CA2201.severity = error   # Do not raise reserved exception types
dotnet_diagnostic.CA2208.severity = error   # Instantiate argument exceptions correctly
dotnet_diagnostic.CA2200.severity = error   # Rethrow to preserve stack details
dotnet_diagnostic.S2486.severity = error    # Exceptions should not be ignored
dotnet_diagnostic.S108.severity = error     # Nested blocks of code should not be left empty
dotnet_diagnostic.S2139.severity = warning  # Exceptions should be either logged or rethrown, not both
dotnet_diagnostic.CA1065.severity = warning # Do not raise exceptions in unexpected locations
dotnet_diagnostic.CA1307.severity = warning # Specify StringComparison for clarity
dotnet_diagnostic.CA1309.severity = warning # Use ordinal StringComparison
dotnet_diagnostic.CA1851.severity = warning # Possible multiple enumerations of IEnumerable collection
dotnet_diagnostic.CA1827.severity = warning # Do not use Count()/LongCount() when Any() can be used
dotnet_diagnostic.CA1829.severity = warning # Use Length/Count property instead of Count() when available
dotnet_diagnostic.CA1860.severity = warning # Avoid using 'Enumerable.Any()' extension method
dotnet_diagnostic.CA1852.severity = warning # Seal internal types
dotnet_diagnostic.S2933.severity = warning  # Fields that are only assigned in the constructor should be readonly
dotnet_diagnostic.CA2211.severity = error   # Non-constant fields should not be visible
dotnet_diagnostic.CA1848.severity = warning # Use the LoggerMessage delegates
dotnet_diagnostic.CA2254.severity = error   # Template should be a static expression
dotnet_diagnostic.CA2017.severity = error   # Parameter count mismatch in the logging message template
dotnet_diagnostic.CA1727.severity = warning # Use PascalCase for named placeholders in the logging message template

# CA1305/CA1310/CA1311 (locale-sensitive formatting/comparison): `warning` in src/**.cs by default,
# `error` in NetPrints.Generator, NetPrints.Serialization and NetPrints.Core below, where the wrong
# overload breaks byte-identical generated code, JSON or golden fixtures on a non-invariant locale.
dotnet_diagnostic.CA1305.severity = warning # Specify IFormatProvider
dotnet_diagnostic.CA1310.severity = warning # Specify StringComparison for correctness
dotnet_diagnostic.CA1311.severity = warning # Specify a culture or use an invariant version

[src/{NetPrints.Generator,NetPrints.Serialization,NetPrints.Core}/**.cs]
dotnet_diagnostic.CA1305.severity = error # Specify IFormatProvider
dotnet_diagnostic.CA1310.severity = error # Specify StringComparison for correctness
dotnet_diagnostic.CA1311.severity = error # Specify a culture or use an invariant version

# CA1002/CA2227 (expose read-only collection types): `error` in the newer projects below; `suggestion`
# in the legacy NetPrints.Core/NetPrints.Reflection model, which still has public mutable-collection
# APIs a future batch refactors. Not set for other projects: they carry no collection-shaped public
# surface these rules would flag.
[src/{NetPrints.Extensibility,NetPrints.Serialization,NetPrints.Workspace,NetPrints.Generator,NetPrints.Sdk}/**.cs]
dotnet_diagnostic.CA1002.severity = error # Do not expose generic lists
dotnet_diagnostic.CA2227.severity = error # Collection properties should be read only

[src/{NetPrints.Core,NetPrints.Reflection}/**.cs]
dotnet_diagnostic.CA1002.severity = suggestion # Do not expose generic lists
dotnet_diagnostic.CA2227.severity = suggestion # Collection properties should be read only

[src/NetPrints.Editor/**VM.cs]
dotnet_diagnostic.VSTHRD111.severity = none

[src/NetPrints.Editor/**.axaml.cs]
dotnet_diagnostic.VSTHRD111.severity = none

[src/NetPrints.Editor/ModelSync/*.cs]
dotnet_diagnostic.VSTHRD111.severity = none

[src/NetPrints.Editor/Hosting/EditorComposition.cs]
dotnet_diagnostic.VSTHRD111.severity = none

# Resumes on the UI thread deliberately to call the desktop lifetime's Shutdown() after cleanup.
[src/NetPrints.Editor/Hosting/ShutdownCoordinator.cs]
dotnet_diagnostic.VSTHRD111.severity = none

[src/NetPrints.Editor/Hosting/Avalonia/**.cs]
dotnet_diagnostic.VSTHRD111.severity = none

[src/NetPrints.Editor/Graph/GraphDragDrop.cs]
dotnet_diagnostic.VSTHRD111.severity = none

[src/NetPrints.Desktop/**.cs]
dotnet_diagnostic.VSTHRD111.severity = none
