<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:NetPrints.Editor"
             xmlns:edgraph="clr-namespace:NetPrints.Editor.Graph"
             xmlns:ednodes="clr-namespace:NetPrints.Editor.Graph.Nodes"
             xmlns:edpins="clr-namespace:NetPrints.Editor.Graph.Pins"
             xmlns:edsearch="clr-namespace:NetPrints.Editor.Search"
             xmlns:nn="clr-namespace:Nodify.Avalonia.Nodes;assembly=Nodify.Avalonia"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NetPrints.Editor.Graph.Nodes.NodeView"
             x:DataType="ednodes:NodeVM"
             ToolTip.Tip="{Binding ToolTip}">
  <UserControl.Resources>
    <!-- Pin connector: exec = square, data = circle, type = triangle; dimmed when unconnected (PAR-43). -->
    <ControlTemplate x:Key="PinConnectorTemplate">
      <Panel Width="14" Height="14" x:DataType="edpins:NodePinVM" Background="Transparent">
        <Rectangle Classes="pin" Width="14" Height="14" StrokeThickness="3" IsVisible="{Binding ShowRectangle}">
          <Rectangle.Fill>
            <MultiBinding Converter="{x:Static edgraph:PinFillConverter.Instance}">
              <Binding Path="Kind" />
              <Binding Path="IsDimmed" />
            </MultiBinding>
          </Rectangle.Fill>
        </Rectangle>
        <Ellipse Classes="pin" Width="14" Height="14" StrokeThickness="3" IsVisible="{Binding ShowCircle}">
          <Ellipse.Fill>
            <MultiBinding Converter="{x:Static edgraph:PinFillConverter.Instance}">
              <Binding Path="Kind" />
              <Binding Path="IsDimmed" />
            </MultiBinding>
          </Ellipse.Fill>
        </Ellipse>
        <Polygon Classes="pin" Points="0,0 13,7 0,14" StrokeThickness="1" IsVisible="{Binding ShowTriangle}">
          <Polygon.Fill>
            <MultiBinding Converter="{x:Static edgraph:PinFillConverter.Instance}">
              <Binding Path="Kind" />
              <Binding Path="IsDimmed" />
            </MultiBinding>
          </Polygon.Fill>
        </Polygon>
        <!-- Default-value indicator -->
        <Polygon Points="0,0 6,7 0,14" IsHitTestVisible="False" IsVisible="{Binding ShowDefaultValueIndicator}"
                 Fill="{Binding IsDefaultValueActive, Converter={x:Static edgraph:DefaultValueBrushConverter.Instance}}" />
      </Panel>
    </ControlTemplate>

    <!-- Pin header: inline editors for unconnected inputs (PAR-44) and the (editable) name (PAR-45). -->
    <DataTemplate x:Key="PinHeaderTemplate" x:DataType="edpins:NodePinVM">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBox Classes="pinValue" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.PinValueText}" MinWidth="60" Text="{Binding UnconnectedText}" PlaceholderText="{Binding UnconnectedTextWatermark}"
                 IsVisible="{Binding ShowUnconnectedValue}" />
        <ComboBox Classes="pinValue" ItemsSource="{Binding PossibleEnumNames}" SelectedItem="{Binding UnconnectedEnumName}"
                  IsVisible="{Binding ShowEnumValue}" />
        <CheckBox Classes="pinValue" IsChecked="{Binding UnconnectedBool}" IsVisible="{Binding ShowBooleanValue}" />
        <TextBlock Text="{Binding DisplayName}" IsVisible="{Binding ShowLabel}" FontSize="14" FontWeight="SemiBold"
                   Foreground="#FFEEEEEE" VerticalAlignment="Center" />
        <TextBox Text="{Binding Name}" IsVisible="{Binding ShowEditableName}" FontSize="14" FontWeight="SemiBold" MinWidth="60" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Shape.pin:pointerover">
      <Setter Property="Stroke" Value="White" />
    </Style>
    <Style Selector="Border#NodeBorder">
      <Setter Property="MinWidth" Value="224" />
    </Style>
    <Style Selector="Border#NodeBorder.reroute">
      <Setter Property="MinWidth" Value="56" />
    </Style>
    <Style Selector="Grid#PinArea">
      <Setter Property="Margin" Value="10,10,10,5" />
    </Style>
    <Style Selector="Grid#PinArea.reroute">
      <Setter Property="Margin" Value="0" />
    </Style>
  </UserControl.Styles>

  <!-- Node (PAR-39..42): header colored by kind, selected border, shadow, label. -->
  <Border x:Name="NodeBorder" Classes.reroute="{Binding IsRerouteNode}"
          BorderThickness="2" Background="#AA202020" BoxShadow="4 4 8 0 #80000000"
          BorderBrush="{Binding IsSelected, Converter={x:Static edgraph:SelectedBorderConverter.Instance}}">
    <StackPanel>
      <Border x:Name="Header" Height="46" IsVisible="{Binding !IsRerouteNode}"
              Background="{Binding VisualKind, Converter={x:Static edgraph:NodeKindBrushConverter.Instance}}">
        <Grid ColumnDefinitions="Auto,Auto,*">
          <!-- Overload chooser (PAR-40) -->
          <ComboBox x:Name="Overloads" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.NodeOverloads}" Margin="2" Width="24" ToolTip.Tip="Overloads" IsVisible="{Binding ShowOverloads}"
                    ItemsSource="{Binding Overloads}" SelectedItem="{Binding SelectedOverload}" MaxDropDownHeight="400">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static edsearch:MethodSpecifierConverter.Instance}}" x:CompileBindings="False" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock x:Name="NodeLabel" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.NodeLabel}" Grid.Column="1" Text="{Binding Label}" Margin="10" FontWeight="SemiBold" FontSize="18"
                     Foreground="#FFEEEEEE" VerticalAlignment="Center" />
          <!-- Pure (PAR-41) -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0" HorizontalAlignment="Right" IsVisible="{Binding CanSetPure}">
            <TextBlock Text="Pure" VerticalAlignment="Center" Margin="0,0,4,0" />
            <CheckBox IsChecked="{Binding IsPure}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.NodePure}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="PinArea" Classes.reroute="{Binding IsRerouteNode}" ColumnDefinitions="*,*">
        <StackPanel>
          <ItemsControl x:Name="InputPins" ItemsSource="{Binding Inputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="edpins:NodePinVM">
                <nn:NodeInput Height="28" Header="{Binding}" ToolTip.Tip="{Binding ToolTip}"
                              HeaderTemplate="{StaticResource PinHeaderTemplate}"
                              ConnectorTemplate="{StaticResource PinConnectorTemplate}"
                              IsConnected="{Binding IsConnected}"
                              Anchor="{Binding Anchor, Mode=OneWayToSource, Converter={x:Static edgraph:GraphPointConverter.Instance}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Left +/- (PAR-42) -->
          <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowLeftPinButtons}">
            <Button Classes="icon" ToolTip.Tip="{Binding LeftPlusToolTip}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.NodeLeftPlus}" Command="{Binding LeftPinsPlusCommand}">
              <mi:MaterialIcon Kind="Plus" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="{Binding LeftMinusToolTip}" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.NodeLeftMinus}" Command="{Binding LeftPinsMinusCommand}">
              <mi:MaterialIcon Kind="Minus" />
            </Button>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1">
          <ItemsControl x:Name="OutputPins" ItemsSource="{Binding Outputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="edpins:NodePinVM">
                <nn:NodeOutput Height="28" Header="{Binding}" ToolTip.Tip="{Binding ToolTip}"
                               HeaderTemplate="{StaticResource PinHeaderTemplate}"
                               ConnectorTemplate="{StaticResource PinConnectorTemplate}"
                               IsConnected="{Binding IsConnected}"
                               Anchor="{Binding Anchor, Mode=OneWayToSource, Converter={x:Static edgraph:GraphPointConverter.Instance}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Right +/- (PAR-42) -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding ShowRightPinButtons}">
            <Button Classes="icon" ToolTip.Tip="{Binding RightPlusToolTip}" Command="{Binding RightPinsPlusCommand}">
              <mi:MaterialIcon Kind="Plus" />
            </Button>
            <Button Classes="icon" ToolTip.Tip="{Binding RightMinusToolTip}" Command="{Binding RightPinsMinusCommand}">
              <mi:MaterialIcon Kind="Minus" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
