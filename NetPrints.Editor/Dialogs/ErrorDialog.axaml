<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:NetPrints.Editor"
        x:Class="NetPrints.Editor.Dialogs.ErrorDialog"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        Width="700" Height="400"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="8">
    <!-- Read-only but selectable so the error can be copied. -->
    <TextBox x:Name="MessageBox" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ErrorMessage}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
             FontFamily="monospace" VerticalContentAlignment="Top" />
    <Button Grid.Row="1" x:Name="OkButton" AutomationProperties.AutomationId="{x:Static ed:AutomationIds.ErrorOkButton}" Content="OK" HorizontalAlignment="Right" Margin="0,8,0,0" MinWidth="80"
            IsDefault="True" Click="OnOkClicked" />
  </Grid>
</Window>
