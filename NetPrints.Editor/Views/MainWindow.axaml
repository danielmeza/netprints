<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetPrints.Editor.ViewModels"
        xmlns:core="clr-namespace:NetPrints.Core;assembly=NetPrints"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="NetPrints.Editor.Views.MainWindow"
        x:DataType="vm:MainEditorVM"
        Title="{Binding Title}"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        Width="800" Height="600">
  <Panel>
    <SplitView IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
               PanePlacement="Right" DisplayMode="Overlay" OpenPaneLength="300">
      <SplitView.Pane>
        <Panel Margin="8">
          <!-- Project pane (PAR-02..06) -->
          <StackPanel x:Name="ProjectPane" IsVisible="{Binding IsProjectPaneOpen}" Spacing="4">
            <TextBlock Classes="header" Text="Project" />
            <Button Classes="flat" Content="Create Project" Command="{Binding CreateProjectCommand}" />
            <Button Classes="flat" Content="Open Project" Command="{Binding OpenProjectCommand}" />
            <Button Classes="flat" Content="Save Project" Command="{Binding SaveProjectCommand}" />
          </StackPanel>

          <!-- Settings pane (PAR-07) -->
          <StackPanel x:Name="SettingsPane" IsVisible="{Binding IsSettingsPaneOpen}" Spacing="4">
            <TextBlock Classes="header" Text="Settings" />
            <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="What to output on compilation.">
              <TextBlock Text="Output" VerticalAlignment="Center" Margin="4" />
              <ComboBox Grid.Column="1" Margin="4" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding IsProjectOpen}"
                        ItemsSource="{Binding CompilationOutputs}"
                        SelectedItem="{Binding CompilationOutput}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="Type of binary to output.">
              <TextBlock Text="Binary type" VerticalAlignment="Center" Margin="4" />
              <ComboBox Grid.Column="1" Margin="4" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding IsProjectOpen}"
                        ItemsSource="{Binding BinaryTypes}"
                        SelectedItem="{Binding OutputBinaryType}" />
            </Grid>
          </StackPanel>
        </Panel>
      </SplitView.Pane>

      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="5">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ProjectButton" Classes="round" Content="Project" Command="{Binding ToggleProjectPaneCommand}" />
          <Button x:Name="ReferencesButton" Classes="round" Content="References" Command="{Binding ShowReferencesCommand}" />
          <Button x:Name="SettingsButton" Classes="round" Content="Settings" Command="{Binding ToggleSettingsPaneCommand}" />
          <Button x:Name="CompileButton" Classes="round" Content="Compile" Command="{Binding CompileCommand}"
                  ToolTip.Tip="Compiles the project and outputs the source code if chosen." />
          <Button x:Name="RunButton" Classes="round" Content="Run" Command="{Binding RunCommand}"
                  ToolTip.Tip="Compile and run the project. Only enabled for executable projects that output binaries. Requires a static Main method." />
        </StackPanel>

        <TextBlock Grid.Row="1" Classes="header" Text="Classes" Margin="5,10,5,0" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*">
          <Button x:Name="NewClassButton" Classes="flat" Content="New Class" Command="{Binding NewClassCommand}" FontSize="16" />
          <Button Grid.Column="1" Classes="flat" Content="Existing Class" Command="{Binding AddExistingClassCommand}" FontSize="16" />
        </Grid>

        <ScrollViewer Grid.Row="3" Margin="5,0,5,5" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ClassList" ItemsSource="{Binding Project.Classes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:ClassGraph">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="flat" Content="{Binding FullName}"
                          Command="{Binding $parent[ItemsControl].((vm:MainEditorVM)DataContext).OpenClassCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="1" Classes="icon" Width="30" Height="30" CornerRadius="15" ToolTip.Tip="Remove class"
                          Command="{Binding $parent[ItemsControl].((vm:MainEditorVM)DataContext).RemoveClassCommand}"
                          CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Minus" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </SplitView>

    <!-- Progress overlay while a project loads (PAR-04) -->
    <Border x:Name="BusyOverlay" IsVisible="{Binding IsBusy}" Background="#AA000000">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="40" Spacing="8">
        <TextBlock Text="{Binding BusyTitle}" FontSize="24" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding BusyMessage}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar IsIndeterminate="True" />
      </StackPanel>
    </Border>
  </Panel>
</Window>
