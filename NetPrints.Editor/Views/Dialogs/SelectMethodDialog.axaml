<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NetPrints.Editor.Converters"
        xmlns:core="clr-namespace:NetPrints.Core;assembly=NetPrints"
        x:Class="NetPrints.Editor.Views.Dialogs.SelectMethodDialog"
        Title="Select Method"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        Width="700" Height="160"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="12" Spacing="8">
    <!-- Method chooser; the first method is preselected (PAR-59). -->
    <ComboBox x:Name="MethodBox" HorizontalAlignment="Stretch" MaxDropDownHeight="400">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="core:MethodSpecifier">
          <TextBlock Text="{Binding Converter={x:Static conv:MethodSpecifierConverter.Instance}}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <Button x:Name="SelectButton" Content="Select" HorizontalAlignment="Right" MinWidth="80" IsDefault="True"
            Click="OnSelectClicked" />
  </StackPanel>
</Window>
