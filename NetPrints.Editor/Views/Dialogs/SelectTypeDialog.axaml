<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetPrints.Editor.Views.Dialogs.SelectTypeDialog"
        Title="Select Type"
        Icon="avares://NetPrints.Editor/Assets/NetPrintsLogo.ico"
        Width="500" Height="160"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="12" Spacing="8">
    <!-- Editable chooser over the non-static types (PAR-58). -->
    <AutoCompleteBox x:Name="TypeBox" FilterMode="ContainsOrdinal" MinimumPrefixLength="1" MaxDropDownHeight="300"
                     PlaceholderText="Type name" />
    <Button x:Name="SelectButton" Content="Select" HorizontalAlignment="Right" MinWidth="80" IsDefault="True"
            Click="OnSelectClicked" />
  </StackPanel>
</Window>
