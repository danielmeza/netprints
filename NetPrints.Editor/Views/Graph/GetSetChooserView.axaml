<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NetPrints.Editor.ViewModels"
             x:Class="NetPrints.Editor.Views.Graph.GetSetChooserView"
             x:DataType="vm:GetSetChooserVM"
             Width="200" Height="60">
  <!-- Get/Set chooser (PAR-55): closes when the pointer leaves. -->
  <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemAccentColor}"
          BorderThickness="1" PointerExited="OnPointerExited">
    <Grid ColumnDefinitions="*,*">
      <Button x:Name="GetButton" Content="Get" Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding GetCommand}" />
      <Button x:Name="SetButton" Grid.Column="1" Content="Set" Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding SetCommand}" />
    </Grid>
  </Border>
</UserControl>
