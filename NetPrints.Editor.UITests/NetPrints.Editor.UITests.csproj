<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every async call in a test must observe TestContext.Current.CancellationToken. -->
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
  </PropertyGroup>

  <!-- No Xunit.DependencyInjection here: its test framework replaces Avalonia's and every
       [AvaloniaFact] fails. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <!-- Use the dependency-free Linux Skia build (no libfontconfig) instead of the default one. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetPrints.Editor\NetPrints.Editor.csproj" />
    <ProjectReference Include="..\NetPrints.Testing.Ui\NetPrints.Testing.Ui.csproj" />
  </ItemGroup>

  <!-- Committed snapshot baselines are read from (and, when updating, written to) the source tree. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SnapshotBaselines</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/Snapshots/Baselines</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="../samples/**" CopyToOutputDirectory="PreserveNewest" LinkBase="samples" />
  </ItemGroup>
</Project>
