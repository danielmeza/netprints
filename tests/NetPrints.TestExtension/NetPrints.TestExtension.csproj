<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NetPrints.TestExtension</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- extension-points.md 8.2: the extension folder is the output, next to netprints-extension.json. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/$(Configuration)/extensions/netprints.test/</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <NetPrintsExperimentalOptIn Include="NPXE0001" />
    <NetPrintsExperimentalOptIn Include="NPXE0002" />
    <NetPrintsExperimentalOptIn Include="NPXE0003" />
    <NetPrintsExperimentalOptIn Include="NPXE0005" />
    <NetPrintsExperimentalOptIn Include="NPXE0006" />
    <NetPrintsExperimentalOptIn Include="NPXE0012" />
    <NetPrintsExperimentalOptIn Include="NPXE0013" />
  </ItemGroup>
  <ItemGroup Condition="'$(NetPrintsPackagedExtensionVersion)' == ''">
    <!-- Compiles TestIcons.axaml into the extension; the host supplies the Avalonia runtime. -->
    <PackageReference Include="Avalonia" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(NetPrintsPackagedExtensionVersion)' != ''">
    <!-- scripts/verify-packages.sh: the single reference an extension author writes, restored from the local feed. -->
    <PackageVersion Include="NetPrints.Extensibility.Abstractions" Version="$(NetPrintsPackagedExtensionVersion)" />
    <PackageReference Include="NetPrints.Extensibility.Abstractions" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(NetPrintsPackagedExtensionVersion)' == ''">
    <!-- The host supplies these: the extension must see the host's copy, so nothing is copied to its folder. -->
    <ProjectReference Include="..\..\src\NetPrints.Core\NetPrints.Core.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\NetPrints.Reflection\NetPrints.Reflection.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\NetPrints.Serialization\NetPrints.Serialization.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\NetPrints.Catalog\NetPrints.Catalog.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\NetPrints.Extensibility.Abstractions\NetPrints.Extensibility.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="netprints-extension.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
