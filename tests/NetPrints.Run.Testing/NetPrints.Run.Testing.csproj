<Project Sdk="Microsoft.NET.Sdk">
  <!-- The run profile cases (card C-06) and the fakes the resolver, planner, CLI and editor tests share. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.assert" />
    <!-- Transitively pulled in by the NetPrints.Workspace project reference;
         ExcludeAssets/PrivateAssets satisfies MSBuildLocator's own MSBL001 guard (research K10) here too. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPrints.Workspace\NetPrints.Workspace.csproj" />
    <ProjectReference Include="..\NetPrints.Testing\NetPrints.Testing.csproj" />
  </ItemGroup>
</Project>
