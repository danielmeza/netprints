<Project>
  <!-- Fixture extensions: the parent props (analyzers, the experimental opt-in target) apply, then each project's extension folder is its output. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- extension-points.md 8.2: the extension folder is the output, next to netprints-extension.json. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Include="netprints-extension.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('netprints-extension.json')" />
  </ItemGroup>
</Project>
