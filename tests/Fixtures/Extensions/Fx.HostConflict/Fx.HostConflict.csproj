<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Fx.HostConflict</AssemblyName>
    <OutputPath>bin/$(Configuration)/extensions/fx.host-conflict/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host supplies these: the extension must see the host's copy, so nothing is copied to its folder. -->
    <ProjectReference Include="..\..\..\..\src\NetPrints.Core\NetPrints.Core.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\..\src\NetPrints.Reflection\NetPrints.Reflection.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\..\src\NetPrints.Serialization\NetPrints.Serialization.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\..\src\NetPrints.Catalog\NetPrints.Catalog.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\..\src\NetPrints.Extensibility\NetPrints.Extensibility.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FxKit.cs" Link="FxKit.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built against version 2 of a library the test host already holds in version 1; never copied. -->
    <ProjectReference Include="..\Fixture.HostLib.V2\Fixture.HostLib.V2.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
