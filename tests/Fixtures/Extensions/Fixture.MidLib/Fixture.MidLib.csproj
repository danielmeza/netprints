    <AssemblyName>Fixture.MidLib</AssemblyName>
    <RootNamespace>Fixture</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <MinVerSkip>true</MinVerSkip>
