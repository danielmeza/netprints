<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>NetPrints.Catalog.Tests</AssemblyName>
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <NetPrintsExperimentalOptIn Include="NPXE0004" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPrints.Catalog\NetPrints.Catalog.csproj" />
    <!-- Aliased: the shared engine sources compiled into Annotations would clash with NetPrints.Catalog's own types. -->
    <ProjectReference Include="..\..\src\NetPrints.Annotations\NetPrints.Annotations.csproj" Aliases="Annotations" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built first, never referenced: the tests load it from its own output folder. -->
    <ProjectReference Include="..\Fixtures\Catalog\CatalogFixtureLib\CatalogFixtureLib.csproj" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CatalogFixtureLibOutput</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'Fixtures', 'Catalog', 'CatalogFixtureLib', 'bin', '$(Configuration)', 'net10.0'))</_Parameter2>
    </AssemblyAttribute>
    <!-- The AN-T10 sample sources use the injected attributes, so they are test data for a temporary project, never compiled here. -->
    <Compile Remove="EndToEnd/AnnotatedSample/**" />
    <None Include="EndToEnd/AnnotatedSample/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Profiles\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Format\Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
