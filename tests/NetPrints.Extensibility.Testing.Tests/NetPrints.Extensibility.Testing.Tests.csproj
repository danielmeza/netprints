<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>NetPrints.Extensibility.Testing.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPrints.Extensibility.Testing\NetPrints.Extensibility.Testing.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Extensibility.Testing.Xunit\NetPrints.Extensibility.Testing.Xunit.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Core\NetPrints.Core.csproj" />
    <ProjectReference Include="..\NetPrints.Testing\NetPrints.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Fixtures\Extensions\Shared\FxKit.cs" Link="Fixtures\FxKit.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built first, never referenced: the tests load each fixture from its own output folder. -->
    <ProjectReference Include="..\Fixtures\Extensions\Fx.Alpha\Fx.Alpha.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Extensions\Conformance\Fx.Fail.Manifest\Fx.Fail.Manifest.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Extensions\Conformance\Fx.Fail.Packaging\Fx.Fail.Packaging.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Extensions\Conformance\Fx.Fail.TypeIdentity\Fx.Fail.TypeIdentity.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Extensions\Conformance\Fx.Fail.Registration\Fx.Fail.Registration.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Extensions\Conformance\Fx.Fail.RegistryIssues\Fx.Fail.RegistryIssues.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Extensions\Conformance\Fx.Fail.RoundTrip\Fx.Fail.RoundTrip.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Extensions\Conformance\Fx.Fail.Translation\Fx.Fail.Translation.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Extensions\Conformance\Fx.Fail.Determinism\Fx.Fail.Determinism.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
