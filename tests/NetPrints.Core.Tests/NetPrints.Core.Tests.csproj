<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>NetPrints.Core.Tests</AssemblyName>
    <!-- Every async call in a test must observe TestContext.Current.CancellationToken. -->
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- FileSystemDocumentStoreTests: a TestScheduler to drive Changes' debounce deterministically. -->
    <PackageReference Include="Microsoft.Reactive.Testing" />
    <!-- SnowflakeIdGeneratorTests: a deterministic, controllable clock. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- Referencing NetPrints.Workspace pulls in Microsoft.CodeAnalysis.Workspaces.MSBuild, whose own
         dependency on Microsoft.Build.Framework carries no asset exclusion of its own (MSBuildLocator's
         MSBL001, research K10): pin and exclude both here too, exactly like NetPrints.Workspace.csproj. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../samples/**" CopyToOutputDirectory="PreserveNewest" LinkBase="samples" />
    <!-- Golden/*.cs are recorded C# text, not sources to compile. -->
    <Compile Remove="Fixtures/Golden/**/*.cs" />
    <None Include="Fixtures/Golden/**/*.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPrints.Core\NetPrints.Core.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Serialization\NetPrints.Serialization.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Generator\NetPrints.Generator.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Workspace\NetPrints.Workspace.csproj" />
  </ItemGroup>

</Project>
