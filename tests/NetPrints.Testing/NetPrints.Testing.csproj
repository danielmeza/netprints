<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared test-support fixtures with no UI/Avalonia dependency, used by every test assembly
       that touches samples/ (Core.Tests, Editor.Tests, Editor.UITests, Desktop.E2ETests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Aliased and private: the shared engine sources compiled into Annotations would clash with NetPrints.Catalog's own types. -->
    <ProjectReference Include="..\..\src\NetPrints.Annotations\NetPrints.Annotations.csproj" Aliases="Annotations" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExtensionHarness: loads extensions and drives the translator, the document format and the generator. -->
    <ProjectReference Include="..\..\src\NetPrints.Core\NetPrints.Core.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Extensibility\NetPrints.Extensibility.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Generation\NetPrints.Generation.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Serialization\NetPrints.Serialization.csproj" />
  </ItemGroup>
</Project>
