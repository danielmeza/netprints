<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared UI test architecture: driver abstraction, page objects, Screenplay layer and
       snapshot helpers, used by the headless UI tests and the desktop E2E tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPrints.Editor\NetPrints.Editor.csproj" />
  </ItemGroup>
</Project>
