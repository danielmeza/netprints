<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared UI test architecture: driver abstraction, page objects, Screenplay layer and
       snapshot helpers, used by the headless UI tests and the desktop E2E tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="xunit.v3.assert" />
    <!-- Transitively pulled in by the NetPrints.Editor -> NetPrints.Workspace project reference;
         ExcludeAssets/PrivateAssets satisfies MSBuildLocator's own MSBL001 guard (research K10) here too. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPrints.Editor\NetPrints.Editor.csproj" />
  </ItemGroup>
</Project>
