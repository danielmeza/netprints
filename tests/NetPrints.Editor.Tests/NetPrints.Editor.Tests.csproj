<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Every async call in a test must observe TestContext.Current.CancellationToken. -->
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <NetPrintsExperimentalOptIn Include="NPXE0001" />
    <NetPrintsExperimentalOptIn Include="NPXE0002" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Xunit.DependencyInjection" />
    <PackageReference Include="Microsoft.Reactive.Testing" />
    <!-- RC-T09 (DocumentationTests): NetPrints.Workspace pulls in Microsoft.CodeAnalysis.Workspaces.MSBuild,
         whose own dependency on Microsoft.Build.Framework carries no asset exclusion of its own
         (MSBuildLocator's MSBL001, research K10): pin and exclude both here too, exactly like
         NetPrints.Workspace.csproj and NetPrints.Core.Tests.csproj. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPrints.Reflection\NetPrints.Reflection.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Editor\NetPrints.Editor.csproj" />
    <ProjectReference Include="..\..\src\NetPrints.Workspace\NetPrints.Workspace.csproj" />
    <!-- ProjectCheckTests (release contract §5) exercises NetPrints.Desktop.ProjectCheck directly. -->
    <ProjectReference Include="..\..\src\NetPrints.Desktop\NetPrints.Desktop.csproj" />
    <ProjectReference Include="..\NetPrints.Testing\NetPrints.Testing.csproj" />
    <!-- Built first so the extension folder exists; the assembly itself is loaded by the extension loader, not referenced. -->
    <ProjectReference Include="..\NetPrints.TestExtension\NetPrints.TestExtension.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first, never referenced: tests load the fx.catalog extension from its own output folder. -->
    <ProjectReference Include="..\Fixtures\Extensions\Fx.Catalog\Fx.Catalog.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first, never referenced: the embedded-catalog discovery tests read its dll. -->
    <ProjectReference Include="..\Fixtures\Catalog\CatalogAnnotatedLib\CatalogAnnotatedLib.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../samples/**" CopyToOutputDirectory="PreserveNewest" LinkBase="samples" />
  </ItemGroup>
</Project>
