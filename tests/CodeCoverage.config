<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.Testing.Extensions.CodeCoverage settings for CI's coverage run (ci.yml passes this file
     with its coverage-settings flag). Static instrumentation only: the dynamic (CLR profiler) mode is
     inherited by every dotnet child process a test starts, and a child loading NetPrints.Core or
     NetPrints.Serialization makes the coverage controller truncate and recreate that module's shared hit
     buffer while the test host has it mapped, crashing the host with an AccessViolationException
     (docs/adr/0008-static-only-code-coverage.md). -->
<Configuration>
  <CodeCoverage>
    <EnableStaticManagedInstrumentation>True</EnableStaticManagedInstrumentation>
    <EnableDynamicManagedInstrumentation>False</EnableDynamicManagedInstrumentation>
  </CodeCoverage>
</Configuration>
