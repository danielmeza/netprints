<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <NetPrintsExperimentalOptIn Include="NPXE0002" />
    <NetPrintsExperimentalOptIn Include="NPXE0005" />
    <NetPrintsExperimentalOptIn Include="NPXE0009" />
    <NetPrintsExperimentalOptIn Include="NPXE0012" />
    <NetPrintsExperimentalOptIn Include="NPXE0013" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NetPrints.Extensibility.Testing.Xunit" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPrints.Godot\NetPrints.Godot.csproj" />
  </ItemGroup>

  <!-- The kit reads the manifest, the packaging and the type identity from the extension's own build output. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ExtensionFolder</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/NetPrints.Godot/bin/$(Configuration)/extension/'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
