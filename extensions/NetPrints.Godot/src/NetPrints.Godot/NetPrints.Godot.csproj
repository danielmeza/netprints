<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NetPrintsExtensionId>netprints.godot</NetPrintsExtensionId>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/$(Configuration)/extension/</OutputPath>
  </PropertyGroup>

  <!-- The extension package: a NuGet package of type NetPrintsExtension that holds the extension folder under extension/. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NetPrints.Godot</PackageId>
    <Version>0.1.0</Version>
    <Description>A sample NetPrints extension for Godot: the godot project profile, a Godot project template with launch profiles, a command, a settings section and a status bar item.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageType>NetPrintsExtension</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddExtensionFolder</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <NetPrintsExperimentalOptIn Include="NPXE0002" />
    <NetPrintsExperimentalOptIn Include="NPXE0005" />
    <NetPrintsExperimentalOptIn Include="NPXE0009" />
    <NetPrintsExperimentalOptIn Include="NPXE0012" />
    <NetPrintsExperimentalOptIn Include="NPXE0013" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host supplies the NetPrints assemblies at run time; the extension must see the host's own copies. -->
    <PackageReference Include="NetPrints.Extensibility.Abstractions" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="netprints-extension.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="AddExtensionFolder">
    <ItemGroup>
      <ExtensionFile Include="@(IntermediateAssembly)" />
      <ExtensionFile Include="netprints-extension.json" />
      <ExtensionFile Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
      <TfmSpecificPackageFile Include="@(ExtensionFile)" PackagePath="extension/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
