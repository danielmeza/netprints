<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The packages scripts/pack-local.sh writes; a CI job adds the packed feed through RestoreAdditionalProjectSources. -->
    <add key="local-packages" value="../../local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
