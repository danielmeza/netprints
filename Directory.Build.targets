<Project>
  <Import Project="eng/PackageReadme.targets" Condition="'$(IsPackable)' == 'true'" />
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets/icons/netprints-icon.png"
          Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
  <!-- ADR-0017: per-project, per-id opt-in to [Experimental] APIs; items are only visible inside a target. -->
  <Target Name="NetPrintsExperimentalOptIn" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_NetPrintsBadOptIn Include="@(NetPrintsExperimentalOptIn)" Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^NPXE\d{4}$'))" />
    </ItemGroup>
    <Error Condition="'@(_NetPrintsBadOptIn)' != ''" Text="NetPrintsExperimentalOptIn accepts only NPXE ids (ADR-0017): @(_NetPrintsBadOptIn)" />
    <PropertyGroup>
      <NoWarn>$(NoWarn);@(NetPrintsExperimentalOptIn)</NoWarn>
    </PropertyGroup>
  </Target>
</Project>
